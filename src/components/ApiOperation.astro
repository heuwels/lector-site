---
// One endpoint on /docs/api/: a closed row that opens into parameters, the
// request body, and the responses. Plain <details>, so it needs no JavaScript.
import ApiField from "./ApiField.astro";
import SchemaFields from "./SchemaFields.astro";
import {
  contentType,
  curl,
  errors,
  inlineParts,
  jsonSchema,
  params,
  successes,
  typeLabel,
  type Endpoint,
  type OpenApiDocument,
} from "../lib/openapi";

interface Props {
  endpoint: Endpoint;
  doc: OpenApiDocument;
  /** Server the curl example calls. */
  server: string;
}

const { endpoint, doc, server } = Astro.props;
const { method, path, operation, id } = endpoint;

const pathParams = params(operation, doc, "path");
const queryParams = params(operation, doc, "query");
const body = operation.requestBody;
const bodySchema = jsonSchema(body);
const bodyType = contentType(body);
const ok = successes(operation);
const other = errors(operation);
const scope = operation["x-token-scope"];
---

<details class="api-op" id={id}>
  <summary>
    <span class="api-head">
      <span class={`api-method api-method-${method.toLowerCase()}`}>{method}</span>
      <code class="api-path">{path}</code>
      <span class="api-summary">{operation.summary}</span>
    </span>
    {
      scope ? (
        <span class="api-scope"> {scope}</span>
      ) : (
        <span class="api-scope api-scope-none"> no token</span>
      )
    }
  </summary>

  <div class="api-detail">
    {
      operation.description && (
        <p class="api-description">
          {inlineParts(operation.description).map((part) =>
            part.code ? <code>{part.text}</code> : part.text,
          )}
        </p>
      )
    }

    {
      pathParams.length > 0 && (
        <>
          <h4>Path parameters</h4>
          <ul class="api-params">
            {pathParams.map((param) => (
              <ApiField
                name={param.name ?? ""}
                type={typeLabel(param.schema, doc)}
                required
                description={param.description}
              />
            ))}
          </ul>
        </>
      )
    }

    {
      queryParams.length > 0 && (
        <>
          <h4>Query parameters</h4>
          <ul class="api-params">
            {queryParams.map((param) => (
              <ApiField
                name={param.name ?? ""}
                type={typeLabel(param.schema, doc)}
                required={param.required}
                description={param.description}
              />
            ))}
          </ul>
        </>
      )
    }

    {
      body && (
        <>
          <h4>
            Request body
            {bodyType && bodyType !== "application/json" && (
              <>
                {' '}
                <span class="api-ctype">{bodyType}</span>
              </>
            )}
          </h4>
          {bodySchema?.description && (
            <p class="api-note">
              {inlineParts(bodySchema.description).map((part) =>
                part.code ? <code>{part.text}</code> : part.text,
              )}
            </p>
          )}
          <SchemaFields schema={bodySchema} doc={doc} />
        </>
      )
    }

    <h4>Responses</h4>
    <ul class="api-responses">
      {
        ok.map(([status, response]) => (
          <li>
            <span class="api-status api-status-ok">{status}</span>
            <span class="api-status-doc"> {response.description}</span>
            {jsonSchema(response) && (
              <span class="field-type"> {typeLabel(jsonSchema(response), doc)}</span>
            )}
            <SchemaFields schema={jsonSchema(response)} doc={doc} />
          </li>
        ))
      }
      {
        other.map(([status, response]) => (
          <li>
            <span class="api-status">{status}</span>
            <span class="api-status-doc"> {response.description}</span>
          </li>
        ))
      }
    </ul>

    <h4>Example</h4>
    <pre><code>{curl(endpoint, doc, server)}</code></pre>
  </div>
</details>
