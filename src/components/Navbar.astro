---
import { SITE_PAGES } from "../data/nav";
import { GITHUB, DISCORD, LOGIN_URL, SIGNUP_URL } from "../data/links";
import Button from "./Button.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);

const linkBase =
  "text-sm/7 font-medium whitespace-nowrap transition-colors max-lg:text-2xl/10";
const linkIdle =
  "text-olive-700 hover:text-olive-950 dark:text-olive-400 dark:hover:text-white";
const linkActive = "text-olive-950 dark:text-white";
---

<header
  class="sticky top-0 z-40 border-b border-olive-950/5 bg-olive-100/85 backdrop-blur-md dark:border-white/5 dark:bg-olive-950/85"
>
  <nav>
    <div
      class="mx-auto flex h-[5.25rem] max-w-7xl items-center gap-4 px-6 lg:px-10"
    >
      <div class="flex flex-1 items-center gap-10">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img src="/logo.svg" alt="" width="28" height="28" class="size-7" />
          <span
            class="text-xl font-bold tracking-tight text-olive-950 dark:text-white"
            >lector</span
          >
        </a>
        <div class="flex gap-6 max-lg:hidden">
          {
            SITE_PAGES.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[linkBase, isActive(link.href) ? linkActive : linkIdle]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex items-center justify-end gap-2">
        <a
          href={GITHUB}
          target="_blank"
          rel="noopener"
          aria-label="Lector on GitHub"
          class="inline-flex rounded-full p-1.5 text-olive-700 hover:bg-olive-950/5 hover:text-olive-950 dark:text-olive-400 dark:hover:bg-white/10 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
            ></path>
          </svg>
        </a>
        <a
          href={DISCORD}
          target="_blank"
          rel="noopener"
          aria-label="Lector on Discord"
          class="inline-flex rounded-full p-1.5 text-olive-700 hover:bg-olive-950/5 hover:text-olive-950 dark:text-olive-400 dark:hover:bg-white/10 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path
              d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.291.074.074 0 0 1 .078-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03ZM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.211 0 2.176 1.096 2.157 2.42 0 1.333-.955 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.211 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"
            ></path>
          </svg>
        </a>
        <a
          href={LOGIN_URL}
          class="rounded-full px-3 py-1 text-sm/7 font-medium text-olive-700 transition-colors hover:bg-olive-950/5 hover:text-olive-950 max-sm:hidden dark:text-olive-400 dark:hover:bg-white/10 dark:hover:text-white"
          >Log in</a
        >
        <Button href={SIGNUP_URL} class="max-sm:hidden">Get started free</Button>

        <button
          type="button"
          data-menu-open
          aria-label="Open menu"
          class="inline-flex rounded-full p-1.5 text-olive-950 hover:bg-olive-950/10 lg:hidden dark:text-white dark:hover:bg-white/10"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path
              fill-rule="evenodd"
              d="M3.75 8.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 7.5a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </div>

    <dialog
      id="mobile-menu"
      class="m-0 h-full max-h-none w-full max-w-none border-0 bg-olive-100 p-0 backdrop:bg-olive-100 lg:hidden dark:bg-olive-950 dark:backdrop:bg-olive-950"
    >
      <div class="flex h-full flex-col px-6 py-6">
          <div class="flex items-center justify-between">
            <a href="/" class="inline-flex items-center gap-2.5">
              <img src="/logo.svg" alt="" width="28" height="28" class="size-7" />
              <span
                class="text-xl font-bold tracking-tight text-olive-950 dark:text-white"
                >lector</span
              >
            </a>
            <button
              type="button"
              data-menu-close
              aria-label="Close menu"
              class="inline-flex rounded-full p-1.5 text-olive-950 hover:bg-olive-950/10 dark:text-white dark:hover:bg-white/10"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18 18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <div class="mt-10 flex flex-col gap-6">
            {
              SITE_PAGES.map((link) => (
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[linkBase, isActive(link.href) ? linkActive : linkIdle]}
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href={GITHUB}
              target="_blank"
              rel="noopener"
              class:list={[linkBase, linkIdle]}>GitHub</a
            >
            <a
              href={DISCORD}
              target="_blank"
              rel="noopener"
              class:list={[linkBase, linkIdle]}>Discord</a
            >
          </div>
          <div class="mt-auto flex flex-col gap-2">
            <Button href={SIGNUP_URL} size="lg" class="w-full">Get started free</Button>
            <Button href={LOGIN_URL} variant="soft" size="lg" class="w-full">
              Log in
            </Button>
          </div>
      </div>
    </dialog>
  </nav>
</header>

<script is:inline>
  (function () {
    var dialog = document.getElementById("mobile-menu");
    if (!dialog || typeof dialog.showModal !== "function") return;
    var openBtn = document.querySelector("[data-menu-open]");
    var closeBtn = document.querySelector("[data-menu-close]");
    if (openBtn) {
      openBtn.addEventListener("click", function () {
        dialog.showModal();
      });
    }
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        dialog.close();
      });
    }
  })();
</script>
