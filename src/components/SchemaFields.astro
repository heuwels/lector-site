---
// A flat, indented field list for one JSON schema. Used for request bodies and
// response bodies on /docs/api/.
import ApiField from "./ApiField.astro";
import { fields, type OpenApiDocument, type OpenApiSchema } from "../lib/openapi";

interface Props {
  schema: OpenApiSchema | undefined;
  doc: OpenApiDocument;
}

const { schema, doc } = Astro.props;
const rows = fields(schema, doc);
---

{
  rows.length > 0 && (
    <ul class="schema-fields">
      {rows.map((row) => (
        <ApiField
          name={row.name}
          type={row.type}
          required={row.required}
          description={row.description}
          depth={row.depth}
          enumValues={row.enumValues}
        />
      ))}
    </ul>
  )
}

<style>
  .schema-fields {
    list-style: none;
    margin: 0.35rem 0 1rem;
    padding: 0;
    font-size: 0.9rem;
  }
</style>
