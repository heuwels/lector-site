---
// Language interest form. Posts to /api/language-requests (a Pages Function
// backed by D1). Cloudflare Turnstile guards the endpoint.
//
// The script also fills any [data-language-count="<slug>"] element on the page
// with the number of people who wait for that language. The API returns a
// language only above its public threshold, so a quiet language shows nothing.
import { TURNSTILE_SITE_KEY } from "../data/turnstile";
import { DISCORD } from "../data/links";

interface Props {
  // Anchor target, so a card elsewhere on the page can link to this form.
  id?: string;
  // Languages to offer. "Another language" is always added at the end.
  options: { slug: string; name: string }[];
  heading?: string;
  blurb?: string;
  class?: string;
}

const {
  id = "notify",
  options,
  heading = "Which language do you want next?",
  blurb = "Choose a language and we will email you once, on the day it is ready. No newsletter.",
  class: className,
} = Astro.props;

const field =
  "w-full rounded-lg border border-olive-950/15 bg-white px-3 py-2 text-sm/6 text-olive-950 placeholder:text-olive-500 focus:border-sage-600 focus:ring-2 focus:ring-sage-600/25 focus:outline-none dark:border-white/15 dark:bg-olive-950/40 dark:text-white dark:placeholder:text-olive-500";
const label = "block text-sm/6 font-medium text-olive-950 dark:text-white";
---

<section
  id={id}
  class:list={["scroll-mt-24", className]}
  data-language-notify
>
  <div
    class="flex flex-col gap-6 rounded-2xl bg-olive-950/2.5 p-6 ring-1 ring-olive-950/5 sm:p-8 dark:bg-white/5 dark:ring-white/10 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start lg:gap-10"
  >
    <div class="flex flex-col gap-3">
      <h2 class="font-display text-3xl/9 text-olive-950 sm:text-4xl/12 dark:text-white">
        {heading}
      </h2>
      <p class="max-w-lg text-base/7 text-olive-700 dark:text-olive-400">
        {blurb}
      </p>
      <p class="max-w-lg text-sm/6 text-olive-600 dark:text-olive-500">
        Your build order comes from this list. Want to talk it over? Join
        the <a
          href={DISCORD}
          target="_blank"
          rel="noopener"
          class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
          >Discord</a
        >.
      </p>
      <slot />
    </div>

    <form
      class="flex flex-col gap-4"
      data-notify-form
      data-turnstile-sitekey={TURNSTILE_SITE_KEY}
      novalidate
    >
      <div class="flex flex-col gap-1.5">
        <label class={label} for={`${id}-language`}>Language</label>
        <select class={field} id={`${id}-language`} name="language" required>
          {
            options.map((option) => (
              <option value={option.slug}>{option.name}</option>
            ))
          }
          <option value="other">Another language</option>
        </select>
      </div>

      <div class="flex flex-col gap-1.5" data-other-wrapper hidden>
        <label class={label} for={`${id}-other`}>Which language?</label>
        <input
          class={field}
          id={`${id}-other`}
          name="requestedName"
          type="text"
          maxlength="60"
          autocomplete="off"
          placeholder="Wolof"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label class={label} for={`${id}-email`}>Email</label>
        <input
          class={field}
          id={`${id}-email`}
          name="email"
          type="email"
          maxlength="254"
          autocomplete="email"
          required
          placeholder="you@example.com"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label class={label} for={`${id}-note`}>
          What do you want to read? <span class="font-normal text-olive-600 dark:text-olive-500">(optional)</span>
        </label>
        <textarea
          class={field}
          id={`${id}-note`}
          name="note"
          rows="2"
          maxlength="500"
          placeholder="News sites, and novels at about B1 level."></textarea>
      </div>

      <div data-turnstile-slot></div>

      <button
        type="submit"
        class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-olive-950 px-4 py-2 text-sm/7 font-medium text-white transition-colors hover:bg-olive-800 disabled:opacity-60 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200"
        data-submit
      >
        Notify me
      </button>

      <p
        class="text-sm/6 text-olive-700 dark:text-olive-400"
        role="status"
        aria-live="polite"
        data-status
      >
      </p>

      <p class="text-xs/5 text-olive-600 dark:text-olive-500">
        We keep your address for this one announcement. Read the{" "}
        <a
          href="/privacy/"
          class="underline underline-offset-4">privacy policy</a
        >.
      </p>
    </form>
  </div>

  <noscript>
    <p class="mt-4 text-sm/7 text-olive-700 dark:text-olive-400">
      This form needs JavaScript. Ask for a language in the{" "}
      <a href={DISCORD} class="font-medium underline underline-offset-4"
        >Discord</a
      > instead.
    </p>
  </noscript>
</section>

<script>
  const ENDPOINT = "/api/language-requests";
  const TURNSTILE_SRC =
    "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";

  let turnstileLoader: Promise<void> | null = null;

  function loadTurnstile(): Promise<void> {
    if (window.turnstile) return Promise.resolve();
    if (turnstileLoader) return turnstileLoader;
    turnstileLoader = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("Turnstile failed to load"));
      document.head.appendChild(script);
    });
    return turnstileLoader;
  }

  function renderTurnstile(form: HTMLFormElement): void {
    const slot = form.querySelector<HTMLElement>("[data-turnstile-slot]");
    const siteKey = form.dataset.turnstileSitekey;
    if (!slot || !siteKey || slot.dataset.ready) return;
    window.turnstile?.render(slot, { sitekey: siteKey });
    slot.dataset.ready = "1";
  }

  function armTurnstile(form: HTMLFormElement): void {
    const arm = () => {
      void loadTurnstile().then(() => renderTurnstile(form));
    };
    form.addEventListener("focusin", arm, { once: true });
    form.addEventListener("pointerdown", arm, { once: true });
  }

  // Fill any per-language count on the page. Runs once, after render, so a
  // failed request leaves the cards exactly as they were.
  async function loadCounts(): Promise<void> {
    const slots = document.querySelectorAll<HTMLElement>("[data-language-count]");
    if (!slots.length) return;
    try {
      const res = await fetch(`${ENDPOINT}/counts`);
      if (!res.ok) return;
      const { counts } = (await res.json()) as {
        counts: Record<string, number>;
      };
      for (const slot of slots) {
        const total = counts[slot.dataset.languageCount ?? ""];
        if (!total) continue;
        slot.textContent = `${total.toLocaleString()} waiting`;
        slot.hidden = false;
      }
    } catch {
      // A missing count is not worth reporting to the reader.
    }
  }

  function setUpForm(form: HTMLFormElement): void {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const select = form.querySelector<HTMLSelectElement>('[name="language"]');
    const otherWrapper = form.querySelector<HTMLElement>("[data-other-wrapper]");
    const otherInput = form.querySelector<HTMLInputElement>(
      '[name="requestedName"]',
    );
    const email = form.querySelector<HTMLInputElement>('[name="email"]');
    const note = form.querySelector<HTMLTextAreaElement>('[name="note"]');
    if (!status || !submit || !select || !otherWrapper || !otherInput || !email) {
      return;
    }

    const say = (message: string, isError: boolean): void => {
      status.textContent = message;
      status.classList.toggle("text-red-700", isError);
      status.classList.toggle("dark:text-red-400", isError);
    };

    const syncOther = (): void => {
      const isOther = select.value === "other";
      otherWrapper.hidden = !isOther;
      otherInput.required = isOther;
      if (!isOther) otherInput.value = "";
    };
    select.addEventListener("change", syncOther);
    syncOther();
    armTurnstile(form);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      say("", false);

      if (!email.value.trim()) {
        say("Enter your email address.", true);
        email.focus();
        return;
      }
      if (select.value === "other" && !otherInput.value.trim()) {
        say("Tell us which language you want.", true);
        otherInput.focus();
        return;
      }

      const token =
        form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')
          ?.value ?? "";

      submit.disabled = true;
      say("Please wait…", false);

      try {
        const res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            language: select.value,
            requestedName: otherInput.value.trim(),
            email: email.value.trim(),
            note: note?.value.trim() ?? "",
            turnstileToken: token,
          }),
        });
        const data = (await res.json()) as {
          ok?: boolean;
          count?: number | null;
          error?: string;
        };

        if (!res.ok || !data.ok) {
          say(data.error ?? "An error occurred. Try again.", true);
          window.turnstile?.reset();
          return;
        }

        const chosen =
          select.value === "other"
            ? otherInput.value.trim()
            : (select.options[select.selectedIndex]?.text ?? "that language");
        const tail = data.count
          ? ` ${data.count.toLocaleString()} ${
              data.count === 1 ? "person wants" : "people want"
            } it too.`
          : "";
        form.reset();
        syncOther();
        window.turnstile?.reset();
        say(
          `Thank you. We will email you when ${chosen} is ready.${tail}`,
          false,
        );
        window.plausible?.("Language interest", {
          props: { language: chosen },
        });
      } catch {
        say("An error occurred. Try again.", true);
        window.turnstile?.reset();
      } finally {
        submit.disabled = false;
      }
    });
  }

  // A "Notify me" button on a card elsewhere on the page selects its language
  // in the first form, scrolls to it, then puts the cursor in the email field.
  function setUpCardButtons(): void {
    const form = document.querySelector<HTMLFormElement>("[data-notify-form]");
    const section = document.querySelector<HTMLElement>("[data-language-notify]");
    if (!form || !section) return;

    const select = form.querySelector<HTMLSelectElement>('[name="language"]');
    const email = form.querySelector<HTMLInputElement>('[name="email"]');

    for (const button of document.querySelectorAll<HTMLElement>(
      "[data-notify-language]",
    )) {
      button.addEventListener("click", () => {
        const slug = button.dataset.notifyLanguage ?? "";
        if (select && [...select.options].some((o) => o.value === slug)) {
          select.value = slug;
          select.dispatchEvent(new Event("change"));
        }
        section.scrollIntoView({ behavior: "smooth", block: "center" });
        email?.focus({ preventScroll: true });
      });
    }
  }

  document
    .querySelectorAll<HTMLFormElement>("[data-notify-form]")
    .forEach(setUpForm);
  setUpCardButtons();
  const startCounts = () => {
    void loadCounts();
  };
  ["pointerdown", "keydown", "scroll", "touchstart"].forEach((event) => {
    window.addEventListener(event, startCounts, { once: true, passive: true });
  });
</script>
