---
// Section headline (Instrument Serif), smaller than the hero Heading.
interface Props {
  as?: "h2" | "h3";
  class?: string;
}
const { as: Tag = "h2", class: className } = Astro.props;
---

<Tag
  class:list={[
    "font-display text-[2rem]/10 tracking-tight text-pretty text-olive-950 sm:text-5xl/14 dark:text-white",
    className,
  ]}
>
  <slot />
</Tag>
