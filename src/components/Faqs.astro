---
// Accordion FAQ list. Interactivity comes from @tailwindplus/elements
// (<el-disclosure> + the button's `command="--toggle"`), loaded in Base.astro.
// Question/answer strings may contain inline HTML.
interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  items: FaqItem[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div
  class:list={[
    "divide-y divide-olive-950/10 border-y border-olive-950/10 dark:divide-white/10 dark:border-white/10",
    className,
  ]}
>
  {
    items.map((item, i) => {
      const id = `faq-${i}`;
      return (
        <div id={id}>
          <button
            type="button"
            id={`${id}-question`}
            command="--toggle"
            commandfor={`${id}-answer`}
            class="flex w-full items-start justify-between gap-6 py-5 text-left text-base/7 font-medium text-olive-950 dark:text-white"
          >
            <span set:html={item.question} />
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              class="mt-1 size-5 shrink-0 in-aria-expanded:hidden"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m7.5-7.5h-15"
              />
            </svg>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              class="mt-1 size-5 shrink-0 not-in-aria-expanded:hidden"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15" />
            </svg>
          </button>
          <el-disclosure
            id={`${id}-answer`}
            hidden
            class="-mt-1 flex flex-col gap-2 pr-12 pb-5 text-base/7 text-olive-700 dark:text-olive-400"
          >
            <p set:html={item.answer} />
          </el-disclosure>
        </div>
      );
    })
  }
</div>
