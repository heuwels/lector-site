---
import Container from "./Container.astro";
import { GITHUB, DISCORD } from "../data/links";

const columns = [
  {
    title: "Explore",
    links: [
      { href: "/docs/", label: "Docs" },
      { href: "/pricing/", label: "Pricing" },
      { href: "/roadmap/", label: "Roadmap" },
      { href: "/reference-data/", label: "Reference data" },
      { href: "/blog/local-llm-translation-eval/", label: "Model eval" },
    ],
  },
  {
    title: "Learn",
    links: [
      { href: "/learn/", label: "Learn by reading" },
      { href: "/methodology/", label: "Methodology" },
      { href: "/blog/", label: "Blog" },
    ],
  },
  {
    title: "Community",
    links: [
      { href: GITHUB, label: "GitHub", external: true },
      { href: DISCORD, label: "Discord", external: true },
      { href: "/support/", label: "Support", external: false },
    ],
  },
];
---

<footer class="pt-16">
  <div
    class="bg-olive-950/2.5 py-16 text-olive-950 dark:bg-white/5 dark:text-white"
  >
    <Container class="flex flex-col gap-12">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex flex-col gap-3">
          <a href="/" class="inline-flex items-center gap-2.5">
            <img src="/logo.svg" alt="" width="28" height="28" class="size-7" />
            <span class="text-xl font-bold tracking-tight">lector</span>
          </a>
          <p class="max-w-xs text-sm/7 text-olive-700 dark:text-olive-400">
            A self-hosted reader for learning languages through the things you
            actually want to read.
          </p>
        </div>

        {
          columns.map((col) => (
            <div>
              <h3 class="text-sm/7 font-semibold">{col.title}</h3>
              <ul role="list" class="mt-2 flex flex-col gap-2 text-sm/7">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener" : undefined}
                      class="text-olive-700 hover:text-olive-950 dark:text-olive-400 dark:hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="flex flex-col gap-6 border-t border-olive-950/10 pt-8 dark:border-white/10"
      >
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm/7">
          {
            [
              { href: "/terms/", label: "Terms" },
              { href: "/privacy/", label: "Privacy" },
              { href: "/refunds/", label: "Refunds" },
            ].map((link) => (
              <a
                href={link.href}
                class="text-olive-600 hover:text-olive-950 dark:text-olive-500 dark:hover:text-white"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div
          class="flex flex-col gap-2 text-sm/7 text-olive-600 sm:flex-row sm:items-center sm:justify-between dark:text-olive-500"
        >
          <p>
            <span
              class="text-base font-bold tracking-tight text-olive-950 dark:text-white"
              >lector</span
            > &middot; Latin for &ldquo;reader&rdquo;
          </p>
          <p>
            Built by <a
              href="https://lukeboyle.com"
              class="text-olive-700 hover:text-olive-950 dark:text-olive-400 dark:hover:text-white"
              >Luke Boyle</a
            >
          </p>
        </div>
      </div>
    </Container>
  </div>
</footer>
