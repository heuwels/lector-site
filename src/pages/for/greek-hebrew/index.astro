---
import Base from "../../../layouts/Base.astro";
import Container from "../../../components/Container.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Subheading from "../../../components/Subheading.astro";
import Text from "../../../components/Text.astro";
import Button from "../../../components/Button.astro";
import Faqs from "../../../components/Faqs.astro";
import { DISCORD, GITHUB, SIGNUP_URL } from "../../../data/links";
import { faqPageSchema, breadcrumbSchema } from "../../../lib/schema";
import { languages } from "../../../data/languages";

// Landing page for the biblical and classical languages.
//
// HONESTY RULES for this page (do not edit these away):
//  * The Koine Greek pack SHIPS. Every number on this page comes from that
//    pack's entry in src/data/languages.ts. An earlier version of this page
//    said the pack was unbuilt, months after it shipped. Do not reintroduce
//    that.
//  * Biblical Hebrew does NOT ship. It is `coming-soon` with roadmap issue 255.
//    The cohort ask belongs to Hebrew alone.
//  * The scope limit is the important part: the dictionary and the morphology
//    are Ancient Greek, but the frequency ranks and the cloze bank are built
//    from the Greek New Testament. Somebody who teaches Homer must read that
//    here, in the scope section, not discover it later.
//  * Pricing must match /pricing/. There is no Scholar plan and no per-language
//    price. Do not invent one.
//  * Language answers, never theological ones. Denominationally neutral.
//  * Lexicon data is public domain or permissively licensed. No BDAG, no HALOT.
//
// Prose on this page follows ASD-STE100. See ~/personal/CLAUDE.md.

const SUPPORT = "support@lector.dev";

const pack = (slug: string) => languages.find((language) => language.slug === slug);
const greek = pack("koine-greek");
const latin = pack("latin");
const stat = (slug: string, label: string) =>
  pack(slug)?.stats.find((entry) => entry.label === label)?.value ?? "";

const mailtoSubject = encodeURIComponent("Biblical Hebrew cohort");
const mailtoBody = encodeURIComponent(
  [
    "Hi Luke,",
    "",
    "I want to help shape the Biblical Hebrew pack.",
    "",
    "A little about me:",
    "- Name:",
    "- I am a (pastor / seminary student / teacher / student / other):",
    "- My Hebrew background:",
    "- The text and edition I read most:",
    "",
    "Thanks!",
  ].join("\n"),
);
const HEBREW_MAILTO = `mailto:${SUPPORT}?subject=${mailtoSubject}&body=${mailtoBody}`;

const ships = [
  {
    title: "Morphology-aware lookup",
    body: `${stat("koine-greek", "Inflections")} inflected forms resolve to their lemma, so a tap answers the word in front of you and not a dictionary headword you must work back to. Lookups forgive accent variance, so τὸν finds τόν.`,
  },
  {
    title: "A real dictionary, on your device",
    body: `${stat("koine-greek", "Dictionary")} entries and ${stat("koine-greek", "English senses")} English senses, from Ancient Greek Wiktionary through Kaikki, with per-word lemma data from MorphGNT for the Koine forms that Classical-leaning tables miss.`,
  },
  {
    title: "Corpus-frequency vocabulary",
    body: "Frequency ranks come from the Greek New Testament itself through MorphGNT, with glosses from the Dodson lexicon. The 300 most frequent lemmas cover most of the running text, so early review buys the most reading.",
  },
  {
    title: "Verse-aligned practice",
    body: `${stat("koine-greek", "Cloze bank")} of cloze practice, built from SBLGNT verses aligned to the World English Bible. Every practice sentence keeps its verse reference, so you can always check the context.`,
  },
  {
    title: "Polytonic typing, without the fight",
    body: "Typed practice accepts a mark-stripped answer, because polytonic input needs a specialist keyboard. Type λογος and λόγος is accepted.",
  },
  {
    title: "No audio, on principle",
    body: "Koine pronunciation is reconstructed and disputed. Erasmian, Reuchlinian and period reconstructions all have a claim, so the speaker stays silent rather than teaching you one of them as fact.",
  },
];

const scope = [
  {
    title: "The dictionary reaches past the New Testament",
    body: "The entries come from Ancient Greek Wiktionary, not from a New Testament word list. Homeric, Attic and Byzantine vocabulary is largely there, and the inflection index resolves forms from any period.",
  },
  {
    title: "Reading has no corpus limit",
    body: "Import an EPUB file, paste a passage, or load a page by URL. Homer, Thucydides, a Byzantine chronicle: the reader treats them all as text, and tap-to-define works the same way.",
  },
  {
    title: "Frequency and practice are New Testament only",
    body: "This is the real limit. Ranks come from the Greek NT, and every cloze sentence is a New Testament verse. For Homer the vocabulary order is wrong and the practice register is wrong.",
  },
  {
    title: "What can change that",
    body: "A Classical or Homeric frequency list gives a second spine, the way the Latin pack ranks on the Dickinson core vocabulary. A cloze bank outside the New Testament needs an aligned corpus. The Tatoeba Greek set holds about 1,800 sentences, which is too few.",
  },
];

const limits = [
  {
    title: "It answers language questions",
    body: "Grammar, morphology, vocabulary, and how a phrase works in context. It does not answer theological questions, and it stays denominationally neutral.",
  },
  {
    title: "It brings no BDAG and no HALOT",
    body: "Lexicon data is public domain or permissively licensed, and every source is named on the pack page. Keep your reference shelf. Lector does the reading and the retention, not the exegesis.",
  },
  {
    title: "It is not an interlinear",
    body: "An interlinear reads for you, which is exactly why the language fades. Lector shows you the text, answers the word you tap, and gives it back to you in review until it is yours.",
  },
];

const faqs = [
  {
    question: "Is this a Bible-study or theology tool?",
    answer:
      "No. Lector is a language tool, and it stays denominationally neutral. It helps with grammar, vocabulary, morphology, and how a phrase works in context. It does not answer theological questions, and it never will.",
  },
  {
    question: "What ships today, and what does not?",
    answer: `The <strong>Koine Greek pack ships now</strong>: ${stat("koine-greek", "Dictionary")} dictionary entries, ${stat("koine-greek", "Inflections")} inflected forms, New Testament frequency ranks, and ${stat("koine-greek", "Cloze bank")} of verse-aligned cloze practice. <strong>Biblical Hebrew does not ship yet.</strong> It is on the roadmap, and the cohort on this page is for Hebrew. <a href="/reference-data/koine-greek/">The pack page</a> lists every source and licence.`,
  },
  {
    question: "Does it cover Homer, Attic, and Byzantine Greek?",
    answer:
      "In part, and the split matters. The dictionary and the inflection index come from Ancient Greek Wiktionary. Vocabulary from Homer to the Byzantine period is largely covered, and you can read any text you import. The frequency ranks and every cloze sentence come from the Greek New Testament, so practice and word order suit the NT and not the Iliad. Teachers outside the NT are welcome in the Discord, because a second frequency spine is the next thing to build.",
  },
  {
    question: "Which texts and lexica does it use?",
    answer:
      'Ancient Greek Wiktionary entries through <a href="https://kaikki.org/dictionary/Ancient%20Greek/">Kaikki</a>, with lemma data from MorphGNT. Glosses come from the <a href="https://github.com/biblicalhumanities/Dodson-Greek-Lexicon">Dodson Greek-English lexicon</a>. Cloze sentences come from SBLGNT, aligned to the World English Bible. All of it is public domain or permissively licensed. There is no bundled BDAG and no HALOT, so keep the reference shelf you already own.',
  },
  {
    question: "Why does the speaker button stay silent?",
    answer:
      "Because Koine pronunciation is reconstructed and disputed. Erasmian, Reuchlinian and period reconstructions each have a case, and synthesized audio can only teach one of them as settled fact. The same rule applies to Latin, where classical and ecclesiastical pronunciation disagree.",
  },
  {
    question: "What about Hebrew?",
    answer:
      'Second, and deliberately. Pointed Hebrew is harder engineering than Greek, though less so now. The <a href="/reference-data/arabic/">Arabic pack</a> shipped as the first right-to-left pack, so the reader handles right-to-left text today. Biblical Hebrew is on the roadmap, and the people who write in now shape its priority.',
  },
  {
    question: "Is Latin ready too?",
    answer: `Yes. The Latin pack ships with ${stat("latin", "Dictionary")} entries and ${stat("latin", "Inflections")} inflected forms. Keys strip editorial macrons, so amāre and amare are one key, and the u/v and i/j spellings that editions mix both resolve. Frequency ranks come from the Dickinson College Commentaries core vocabulary. See <a href="/languages/latin/">the Latin guide</a>.`,
  },
  {
    question: "Do I need to be a scholar?",
    answer:
      "No. Morphology help on tap means you can read above your parsing level while it comes back. This suits a pastor who prepares every week, a student in the middle of coursework, and anybody whose hard-won Greek slips away.",
  },
  {
    question: "How is this different from Logos or an interlinear?",
    answer:
      "A reference platform is excellent at exegesis lookup, and an interlinear does the reading for you, which is why the language fades. Lector is a loop. Read the text, tap what you do not know, and keep what matters. Review it until it is yours, in the app and in Anki.",
  },
  {
    question: "Can I use it with no internet connection?",
    answer:
      'Yes. The reader, the on-device dictionary and cloze practice all run with the network off. Read <a href="/use-cases/offline/">offline and remote use</a> for the detail.',
  },
  {
    question: "What does it cost?",
    answer:
      'Self-hosting is free forever, and it is <a href="https://github.com/heuwels/lector">open source</a>, with every language pack included. There is no per-language price and no scholar tier. <a href="/pricing/">Lector Cloud</a> starts at $5 a month if you prefer not to run a server.',
  },
];

const title = "Greek and Hebrew | Lector for biblical languages";
const description = `Read the Greek New Testament in a reading-first workspace. The Koine Greek pack ships now: ${stat("koine-greek", "Inflections")} inflected forms, New Testament frequency ranks, verse-aligned cloze practice, and Anki export. Biblical Hebrew is on the roadmap.`;

const schema = [
  faqPageSchema(faqs),
  breadcrumbSchema([
    { name: "Lector", url: "/" },
    { name: "Greek and Hebrew", url: "/for/greek-hebrew/" },
  ]),
];
---

<Base title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="pt-14 pb-14 sm:pt-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <Eyebrow>Koine Greek ships &middot; Hebrew on the roadmap</Eyebrow>
      <Heading class="max-w-4xl text-5xl/[1.05] sm:text-7xl/[1.05]">
        Keep your Greek by <span class="italic">reading</span> the text.
      </Heading>
      <Text size="lg" class="max-w-3xl text-pretty">
        A reading-first workspace for the Greek New Testament, and it is
        available today. Morphology-aware lookup, corpus-frequency vocabulary,
        verse-aligned review, and Anki export. Help with grammar and phrasing,
        never theological answers.
      </Text>
      <div class="mt-2 flex flex-col items-center gap-3">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg">Start reading Greek</Button>
          <Button href="/reference-data/koine-greek/" variant="soft" size="lg">
            See the pack data
          </Button>
        </div>
        <p class="text-xs/6 text-olive-500">
          {greek?.stats[0]?.value} dictionary entries &middot; {
            stat("koine-greek", "Inflections")
          } inflected forms &middot; self-host free, or Lector Cloud from $5 a month
        </p>
      </div>
    </Container>
  </section>

  <!-- What ships -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Available now</Eyebrow>
        <Subheading>
          Three years of Greek must not have a five-year half-life.
        </Subheading>
        <Text class="text-pretty">
          Almost everybody who learns Greek for ministry watches it fade, not
          from laziness, but because nothing in the week demands the text in its
          own words. Lector makes real reading light enough to do, and makes
          what you read stay learned. Here is what the pack gives you today.
        </Text>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          ships.map((item) => (
            <div class="flex flex-col gap-2 rounded-2xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {item.title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
      <p class="text-xs/6 text-olive-500">
        Every number here comes from <a
          href="/reference-data/koine-greek/"
          class="underline underline-offset-2">the pack page</a
        >, which also names each source and its licence.
      </p>
    </Container>
  </section>

  <!-- Scope -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Read this if you work outside the New Testament</Eyebrow>
        <Subheading>How far past the New Testament does it reach?</Subheading>
        <Text class="text-pretty">
          Some of the way, and the split is worth knowing before you start. The
          honest answer is that the dictionary travels further than the practice
          does.
        </Text>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          scope.map((item) => (
            <div class="flex flex-col gap-2 rounded-2xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {item.title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
      <p class="text-xs/6 text-olive-500">
        Do you teach Homer, Attic, or Byzantine Greek? Come to the <a
          href={DISCORD}
          target="_blank"
          rel="noopener"
          class="underline underline-offset-2">Discord</a
        > and tell us which frequency list your students learn to. That decision needs
        a teacher, not a guess.
      </p>
    </Container>
  </section>

  <!-- Latin -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col gap-6 rounded-3xl bg-olive-950/2.5 p-8 sm:p-12 dark:bg-white/5"
      >
        <div class="flex max-w-2xl flex-col gap-4">
          <Eyebrow>Also available</Eyebrow>
          <Subheading>Latin ships too.</Subheading>
          <Text class="text-pretty">
            {stat("latin", "Dictionary")} entries and {
              stat("latin", "Inflections")
            } inflected forms. Keys strip editorial macrons, so amāre and amare are
            one key. The u/v and i/j spellings that editions mix both resolve, so
            uult finds vult. Frequency ranks come from the Dickinson College Commentaries
            core vocabulary, and the speaker stays silent for the same reason it does
            in Greek.
          </Text>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="/languages/latin/">Read the Latin guide</Button>
          <Button href="/reference-data/latin/" variant="soft">
            See the pack data
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Hebrew cohort -->
  <section class="py-16">
    <Container class="grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      <div class="flex max-w-md flex-col gap-4">
        <Eyebrow>In development</Eyebrow>
        <Subheading>Biblical Hebrew needs readers, now.</Subheading>
        <Text class="text-pretty">
          Hebrew is genuinely unbuilt. Pointed Hebrew is harder than Greek,
          though less so than it was: the Arabic pack shipped first, so the
          reader handles right-to-left text today. What the Hebrew pack needs is
          people who read the Hebrew Bible weekly and will say what helps.
        </Text>
        <div class="flex flex-wrap items-center gap-3">
          <Button href={HEBREW_MAILTO} size="lg">Help shape Hebrew</Button>
          <Button
            href={DISCORD}
            variant="soft"
            size="lg"
            target="_blank"
            rel="noopener"
          >
            Follow along on Discord
          </Button>
        </div>
      </div>
      <div
        class="flex flex-col gap-4 rounded-2xl bg-olive-950 p-8 text-white dark:bg-white/10 dark:ring-1 dark:ring-white/10"
      >
        <h3 class="font-display text-2xl/8">What we ask, and what you get</h3>
        <ul class="flex flex-col gap-3">
          {
            [
              "Tell us the text and the edition you read most.",
              "Tell us which lexicon your students already own.",
              "Read early builds, and say what got in the way.",
              "You get a direct line to the builder, and the pack you helped shape.",
            ].map((item) => (
              <li class="flex gap-3 text-base/7 text-olive-200">
                <span aria-hidden="true" class="mt-px text-olive-400">
                  &#10003;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <!-- Limits -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>What it will not do</Eyebrow>
        <Subheading>The boundaries, stated first.</Subheading>
        <Text class="text-pretty">
          A tool for Scripture reading attracts expectations it must not meet.
          These three lines hold.
        </Text>
      </div>
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-3">
        {
          limits.map((item) => (
            <div class="flex flex-col gap-2 rounded-2xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {item.title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
      <p class="text-xs/6 text-olive-500">
        Build progress is public on <a
          href={GITHUB}
          target="_blank"
          rel="noopener"
          class="underline underline-offset-2">GitHub</a
        >, and discussed as it happens on <a
          href={DISCORD}
          target="_blank"
          rel="noopener"
          class="underline underline-offset-2">Discord</a
        >.
      </p>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <Container class="grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      <div class="flex max-w-md flex-col gap-4">
        <Eyebrow>Straight answers</Eyebrow>
        <Subheading>The questions that matter most.</Subheading>
        <Text class="text-pretty">
          Curious how Lector approaches learning in general? See the <a
            href="/methodology/"
            class="font-medium underline underline-offset-4">method</a
          > it is built on.
        </Text>
      </div>
      <Faqs items={faqs} />
    </Container>
  </section>

  <!-- Final CTA -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col items-center gap-8 rounded-3xl bg-olive-950 px-6 py-16 text-center dark:bg-white/5 dark:ring-1 dark:ring-white/10"
      >
        <Heading
          color="light"
          class="max-w-3xl text-4xl/[1.1] sm:text-6xl/[1.1]"
        >
          Do not let it <span class="italic">fade</span>.
        </Heading>
        <p class="max-w-xl text-pretty text-lg/8 text-olive-300">
          The Greek pack is ready. Import a chapter tonight, tap what you have
          lost, and let review give it back.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg" color="light">
            Start reading Greek
          </Button>
          <Button
            href="/docs/installation/"
            variant="plain"
            size="lg"
            color="light"
          >
            Self-host, free
          </Button>
        </div>
        <p class="text-xs/6 text-olive-400">
          Reading the Hebrew Bible, or teaching outside the New Testament? Write
          to us at <a
            href={`mailto:${SUPPORT}`}
            class="underline underline-offset-2">{SUPPORT}</a
          >.
        </p>
      </div>
    </Container>
  </section>
</Base>
