---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import Subheading from "../components/Subheading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import ActionLink from "../components/ActionLink.astro";
import Faqs from "../components/Faqs.astro";
import { languages } from "../data/languages";
import { GITHUB, SIGNUP_URL, DISCORD } from "../data/links";
import { softwareApplicationSchema, faqPageSchema } from "../lib/schema";

// Feature "moments" — each pairs a real screenshot with a capability. Rendered
// as alternating rows; screenshots live in /public/images.
const moments = [
  {
    eyebrow: "Read",
    title: "Turn any book into a lesson.",
    body: "Import an EPUB, paste an article, or pull one from a URL. Lector renders it in clean Literata typography and colours every word by how well you know it — new, learning, known. Click any word for an instant on-device translation, and an LLM fills in for the rare ones.",
    img: "/images/reader.png",
    alt: "Lector reader showing a novel with colour-coded word states and click-to-translate",
  },
  {
    eyebrow: "Practice",
    title: "Drill the words that matter first.",
    body: "Thousands of Tatoeba sentence pairs, ordered by frequency so you learn the words you'll actually meet. Multiple-choice and typing modes, scheduled by a spaced-repetition system that brings each sentence back exactly when you're about to forget it.",
    img: "/images/cloze.png",
    alt: "Cloze practice with multiple-choice options and mastery tracking",
  },
  {
    eyebrow: "Remember",
    title: "Mine vocabulary. Push it to Anki.",
    body: "Save words as you read and Lector builds your personal vocabulary database, tracking known and learning states. When you're ready, export mined words as Basic or Cloze cards straight into Anki over AnkiConnect — no copy-paste, no plugins.",
    img: "/images/anki.png",
    alt: "Export-to-Anki dialog choosing Basic or Cloze card type",
  },
  {
    eyebrow: "Understand",
    title: "A tutor on call, and an editor for your writing.",
    body: "Ask the built-in LLM tutor grammar questions in plain language. Keep a journal in your target language and get inline corrections with explanations and before/after comparisons. Works with the Claude API or a local model — your choice.",
    img: "/images/chat.png",
    alt: "LLM tutor chat showing a grammar conversation",
  },
  {
    eyebrow: "Organise",
    title: "A library that stays tidy.",
    body: "Group your collections however you think about them, drag to reorder, and drop new books straight into a group. Reading progress follows each collection so you always know where you left off.",
    img: "/images/library-groups.png",
    alt: "Library organised into collapsible groups with drag-to-reorder and reading progress",
  },
];

// The remaining capabilities, kept as a compact list so nothing's lost.
const extras = [
  ["Text-to-speech", "Optional Google Cloud TTS to hear words and sentences pronounced correctly."],
  ["Web & paste import", "Pull an article from any URL via Readability, or paste text directly."],
  ["Offline-first storage", "SQLite server-side, IndexedDB client-side. No cloud accounts, no sync."],
  ["Statistics dashboard", "CEFR fluency, vocabulary growth, reading streaks, activity heatmaps, cloze mastery."],
  ["AI translation with a fallback", "Claude or a local LLM on demand, dropping to a 2,000-word offline dictionary."],
  ["Any language reads", "The reader works with any language; packs add cloze banks and dictionaries."],
];

const completeLanguages = languages.filter((l) => l.status === "complete");

const faqs = [
  {
    question: "Is it really free?",
    answer:
      "Self-hosting is free forever — deploy it once and use it with no subscription or feature gates (your only optional cost is your own LLM API usage if you don't run a local model). Prefer not to run a server? Lector Cloud starts at $5/mo and we host it for you. Either way it's the same app. For comparison, LingQ runs $12.99/mo and Clozemaster Pro about $13/mo.",
  },
  {
    question: "Self-host or cloud — which should I choose?",
    answer:
      "If you're comfortable running a Docker container, self-host: it's free, your data never leaves your hardware, and you bring your own LLM keys. If you'd rather just read and let someone else handle servers, backups, and updates, Lector Cloud (in beta) does exactly that from $5/mo. You can move between them — export any time, no lock-in.",
  },
  {
    question: "Where does my data live?",
    answer:
      "On your hardware. Your reading history, vocabulary, and progress sit in a single SQLite file inside a Docker volume. No third-party databases, no analytics, no telemetry. Backing up is one file copy — rsync, borg, or a USB drive.",
  },
  {
    question: "Do I need an API key or a GPU?",
    answer:
      "No. The reader, cloze practice, and vocabulary tracking all work offline against a built-in dictionary. AI translation, the tutor, and writing correction are the only features that call out — and you can point those at a local model (Ollama, Llama, Gemma) instead of the Claude API.",
  },
  {
    question: "Which languages are supported?",
    answer:
      `The reader works with any language. Language packs — which add frequency-banded cloze banks and on-device dictionaries — currently cover ${completeLanguages
        .map((l) => l.endonym)
        .join(", ")}, with more on the way. Adding a pair is a straightforward pull request.`,
  },
  {
    question: "How is this different from LingQ, Clozemaster, or Anki?",
    answer:
      "It's all three, self-hosted and joined up: LingQ-style reading with click-to-translate, Clozemaster-style frequency cloze, and first-party AnkiConnect export — plus an LLM tutor and a writing journal. One app, your server, your data.",
  },
];
---

<Base
  title="Lector | self-hosted language learning reader"
  description="A self-hosted language learning reader with LingQ-style reading, Clozemaster-style cloze practice, and AnkiConnect integration. Your books, your data."
  schema={[softwareApplicationSchema(), faqPageSchema(faqs)]}
>
  <!-- Hero -->
  <section class="pt-14 pb-20 sm:pt-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <Eyebrow>Open source &middot; self-host or cloud</Eyebrow>
      <Heading class="max-w-4xl text-5xl/[1.05] sm:text-7xl/[1.05]">
        Read your way into a <span class="italic">new language</span>.
      </Heading>
      <Text size="lg" class="max-w-2xl text-pretty">
        Lector turns the books and articles you actually want to read into a
        complete course. Click any word to translate, mine vocabulary as you go,
        drill it with frequency-ordered cloze, and push it to Anki — on our
        cloud, or your own hardware.
      </Text>
      <div class="mt-2 flex flex-col items-center gap-3">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg">Start on the cloud</Button>
          <Button href="/docs/installation/" variant="soft" size="lg">
            Self-host, free
          </Button>
        </div>
        <p class="text-xs/6 text-olive-500">
          Cloud is in beta &middot; self-hosting is free forever
        </p>
      </div>
    </Container>

    <Container class="mt-14">
      <div
        class="mx-auto max-w-5xl rounded-2xl bg-olive-950/2.5 p-2 ring-1 ring-olive-950/5 dark:bg-white/5 dark:ring-white/10"
      >
        <img
          src="/images/reader.png"
          alt="Lector reader view with click-to-translate and word-state colouring"
          width="1600"
          height="1000"
          class="w-full rounded-xl ring-1 ring-black/10"
        />
      </div>
    </Container>
  </section>

  <!-- Feature moments -->
  <section class="py-12">
    <Container class="flex flex-col gap-6">
      {
        moments.map((m, i) => (
          <div class="grid grid-cols-1 items-center gap-8 rounded-2xl bg-olive-950/2.5 p-6 sm:p-10 lg:grid-cols-2 lg:gap-14 dark:bg-white/5">
            <div class:list={["flex flex-col gap-4", i % 2 === 1 && "lg:order-2"]}>
              <Eyebrow>{m.eyebrow}</Eyebrow>
              <Subheading class="text-3xl/9 sm:text-4xl/12">{m.title}</Subheading>
              <Text class="text-pretty">{m.body}</Text>
            </div>
            <div class:list={[i % 2 === 1 && "lg:order-1"]}>
              <img
                src={m.img}
                alt={m.alt}
                loading="lazy"
                class="w-full rounded-xl ring-1 ring-black/10"
              />
            </div>
          </div>
        ))
      }
    </Container>
  </section>

  <!-- Everything else -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>In the box</Eyebrow>
        <Subheading>Everything else, without the sprawl.</Subheading>
      </div>
      <div class="grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          extras.map(([title, body]) => (
            <div class="flex flex-col gap-2 border-t border-olive-950/10 pt-4 dark:border-white/10">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">{body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Languages -->
  <section id="languages" class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Language packs</Eyebrow>
        <Subheading>Languages, ready to read.</Subheading>
        <Text class="text-pretty">
          Each pack ships a frequency-banded cloze bank and an on-device
          dictionary, at the same depth. The reader itself works with any
          language.
        </Text>
      </div>

      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          completeLanguages.map((lang) => (
            <a
              href={`/languages/${lang.slug}/`}
              class="group flex flex-col gap-3 rounded-xl bg-olive-950/2.5 p-6 transition-colors hover:bg-olive-950/5 dark:bg-white/5 dark:hover:bg-white/10"
            >
              <span class="text-3xl">{lang.flag}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-2xl/7 text-olive-950 dark:text-white">
                  {lang.name}
                </h3>
                <p class="text-sm/6 text-olive-600 dark:text-olive-400">
                  {lang.endonym}
                </p>
              </div>
              <span class="mt-auto inline-flex items-center gap-1 text-sm/7 font-medium text-olive-950 group-hover:text-sage-700 dark:text-white dark:group-hover:text-sage-300">
                Learn {lang.name.split("→")[0].trim()}
                <svg viewBox="0 0 16 16" fill="none" class="size-4 transition-transform group-hover:translate-x-0.5">
                  <path d="M6.5 3.5 11 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <div
        class="flex flex-col gap-3 rounded-xl border border-olive-950/10 p-6 sm:flex-row sm:items-center sm:justify-between dark:border-white/10"
      >
        <div class="flex flex-col gap-1">
          <p class="text-base/7 font-semibold text-olive-950 dark:text-white">
            <span class="mr-2">🇮🇹 🇵🇹 🇷🇺 🇨🇳 🇯🇵</span> On the roadmap
          </p>
          <p class="text-sm/7 text-olive-700 dark:text-olive-400">
            Italian and Portuguese slot straight in. Russian is next; Mandarin
            and Japanese follow as a pair (word-segmentation + a reading layer).
          </p>
        </div>
        <Button href={GITHUB} variant="soft" target="_blank" rel="noopener">
          Add your language
        </Button>
      </div>
    </Container>
  </section>

  <!-- Two ways to run it -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Two ways to run it</Eyebrow>
        <Subheading>Open source. Your way.</Subheading>
        <Text class="text-pretty">
          The same app, whichever way you run it. Host it yourself for free, or
          let us run it for you.
        </Text>
      </div>
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
        <div class="flex flex-col gap-4 rounded-2xl bg-olive-950/2.5 p-8 dark:bg-white/5">
          <div class="flex items-center gap-3">
            <h3 class="font-display text-2xl/8 text-olive-950 dark:text-white">
              Self-host
            </h3>
            <span class="inline-flex rounded-full bg-sage-600/15 px-2.5 py-0.5 text-xs font-medium text-sage-700 dark:text-sage-300">
              Free
            </span>
          </div>
          <Text class="flex-1 text-pretty">
            Run the Docker image on your own hardware. Your data never leaves
            your server, you bring your own LLM keys (or run a local model), and
            it's free forever.
          </Text>
          <ActionLink href="/docs/installation/">Read the setup docs</ActionLink>
        </div>

        <div class="flex flex-col gap-4 rounded-2xl bg-olive-950 p-8 text-white dark:bg-white/10 dark:ring-1 dark:ring-white/10">
          <div class="flex items-center gap-3">
            <h3 class="font-display text-2xl/8 text-white">Lector Cloud</h3>
            <span class="inline-flex rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium text-white">
              Beta &middot; from $5/mo
            </span>
          </div>
          <p class="flex-1 text-pretty text-base/7 text-olive-200">
            We host it, back it up, and keep it updated. No Docker, no setup —
            just sign in and start reading. For when you'd rather not run a
            server.
          </p>
          <a
            href={SIGNUP_URL}
            class="group inline-flex items-center gap-2 text-sm/7 font-medium text-white"
          >
            Start on the cloud
            <svg viewBox="0 0 16 16" fill="none" class="size-4 transition-transform group-hover:translate-x-0.5">
              <path d="M6.5 3.5 11 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why self-host -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Why self-host</Eyebrow>
        <Subheading>Your course shouldn't rent your progress back to you.</Subheading>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            ["Your data, your server", "Reading history, vocabulary, and progress live in a SQLite file on your hardware. No third parties, no telemetry."],
            ["No subscriptions", "Deploy once, learn forever. No monthly fees, no premium tiers, no feature gates."],
            ["Works offline", "Reading, cloze, and vocabulary all run without a connection. Only AI features need the internet."],
            ["Simple backup", "One SQLite file, one Docker volume. rsync it, borg it, or copy it to a USB drive."],
          ].map(([title, body]) => (
            <div class="flex flex-col gap-2 rounded-xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">{body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Quick install -->
  <section id="install" class="py-16">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col gap-6">
        <Eyebrow>Get started</Eyebrow>
        <Subheading>Running in about a minute.</Subheading>
        <Text class="text-pretty">
          One Docker container, one volume. Drop this into a
          <code class="rounded bg-olive-950/10 px-1.5 py-0.5 font-mono text-[0.85em] dark:bg-white/10">docker-compose.yml</code>
          and bring it up.
        </Text>
        <div class="flex flex-wrap gap-3">
          <Button href="/docs/installation/" size="lg">Read the docs</Button>
          <ActionLink href="/docs/configuration/">Configuration &amp; env vars</ActionLink>
        </div>
      </div>
      <div
        class="overflow-x-auto rounded-2xl bg-olive-950 p-6 font-mono text-sm/6 text-olive-100 ring-1 ring-black/10 dark:bg-black/40"
      >
        <pre><code><span class="text-olive-400"># Create a directory for Lector</span>
mkdir lector && cd lector

<span class="text-olive-400"># Create a docker-compose.yml</span>
cat &lt;&lt;EOF &gt; docker-compose.yml
services:
  lector:
    image: ghcr.io/heuwels/lector:latest
    container_name: lector
    restart: unless-stopped
    ports:
      - "3400:3000"
    environment:
      - NODE_ENV=production
    volumes:
      - ./data:/app/data
EOF

<span class="text-olive-400"># Start it up</span>
docker compose up -d</code></pre>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <Container class="grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      <div class="flex max-w-md flex-col gap-4">
        <Eyebrow>Questions</Eyebrow>
        <Subheading>Good to know.</Subheading>
        <Text class="text-pretty">
          Still curious? The <a href="/docs/" class="font-medium underline underline-offset-4">docs</a>
          cover installation, reverse proxies, AnkiConnect, and every environment variable.
        </Text>
      </div>
      <Faqs items={faqs} />
    </Container>
  </section>

  <!-- Community -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col items-center gap-6 rounded-2xl bg-olive-950/2.5 px-6 py-12 text-center dark:bg-white/5"
      >
        <Eyebrow>Get involved</Eyebrow>
        <Subheading class="max-w-2xl">Learn alongside other readers.</Subheading>
        <Text class="max-w-xl text-pretty">
          Join our Discord to swap resources, compare progress, request new
          languages, and help shape where Lector goes next.
        </Text>
        <Button href={DISCORD} variant="soft" target="_blank" rel="noopener">
          Join the Discord
        </Button>
      </div>
    </Container>
  </section>

  <!-- Final CTA -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col items-center gap-8 rounded-3xl bg-olive-950 px-6 py-16 text-center dark:bg-white/5 dark:ring-1 dark:ring-white/10"
      >
        <Heading color="light" class="max-w-3xl text-4xl/[1.1] sm:text-6xl/[1.1]">
          Start reading in your <span class="italic">target language</span> today.
        </Heading>
        <p class="max-w-xl text-pretty text-lg/8 text-olive-300">
          Open source to self-host for free, or on our cloud in a click.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg" color="light">Start on the cloud</Button>
          <Button href="/docs/installation/" variant="plain" size="lg" color="light">
            Self-host, free
          </Button>
        </div>
      </div>
    </Container>
  </section>
</Base>
