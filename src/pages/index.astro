---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import Subheading from "../components/Subheading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import ActionLink from "../components/ActionLink.astro";
import Faqs from "../components/Faqs.astro";
import { languages } from "../data/languages";
import LanguageNotify from "../components/LanguageNotify.astro";
import { languageGuides } from "../data/languageGuides";
import { GITHUB, SIGNUP_URL, DISCORD } from "../data/links";
import { softwareApplicationSchema, faqPageSchema } from "../lib/schema";

// Feature "moments" — each pairs a real screenshot with a capability. Rendered
// as alternating rows; screenshots live in /public/images.
const moments = [
  {
    eyebrow: "Read",
    title: "Turn any book into a lesson.",
    body: "Lector imports an EPUB file, an article you paste, or a page from a URL. It colours every word by how well you know it: new, learning, or known. For an instant translation on your device, click any word. For rare words, a large language model (LLM) does the translation.",
    img: "/images/reader.png",
    alt: "The Lector reader with a novel, colour-coded word states, and click-to-translate",
  },
  {
    eyebrow: "Listen",
    title: "Read along with video and audio.",
    body: "Paste a YouTube URL and choose a caption track. Lector imports the transcript, and every line keeps its timestamp. Click a line to move the player to that moment. Lector never downloads or hosts the video. You can also upload a podcast episode. A Whisper model transcribes it, and the current sentence highlights as the audio plays.",
    img: "/images/youtube-transcript-reader.png",
    alt: "A YouTube transcript in Lector with the embedded player and timestamped lines",
  },
  {
    eyebrow: "Practice",
    title: "Practise the words that matter first.",
    body: "Lector holds thousands of Tatoeba sentence pairs. It orders them by frequency, so you learn the words you meet most often. You practise with multiple-choice questions or by typing the answer. A spaced-repetition system returns each sentence to you just before you forget it.",
    img: "/images/cloze.png",
    alt: "Cloze practice with multiple-choice options and mastery tracking",
  },
  {
    eyebrow: "Remember",
    title: "Mine vocabulary. Sync it with Anki.",
    body: "Save words as you read. Lector adds them to your vocabulary database and records the known and learning states. Send mined words and phrases to Anki as Basic or Cloze cards. The Lector add-on also syncs reviews back. The add-on is in beta. When you grade a card in Anki, Lector updates the mastery of that word.",
    img: "/images/anki.png",
    alt: "The export-to-Anki dialog with the Basic and Cloze card types",
  },
  {
    eyebrow: "Understand",
    title: "A tutor for your questions, and an editor for your writing.",
    body: "Ask the built-in tutor your grammar questions in plain language. Keep a journal in your target language. The tutor gives you inline corrections with explanations. It also shows the text before and after each correction. The tutor works with the Claude API or with a local model.",
    img: "/images/chat.png",
    alt: "The tutor chat with a grammar conversation",
  },
  {
    eyebrow: "Organise",
    title: "A library that stays tidy.",
    body: "Group your collections in the way you think about them. Drag a collection to reorder it. Drop new books straight into a group. Lector records the reading progress of each collection, so you always know your position.",
    img: "/images/library-groups.png",
    alt: "Library organised into collapsible groups with drag-to-reorder and reading progress",
  },
];

// The remaining capabilities, kept as a compact list so nothing's lost.
const extras = [
  [
    "Text-to-speech",
    "Lector can use Google Cloud to pronounce words and sentences correctly. This feature is optional.",
  ],
  [
    "Web and paste import",
    "Lector reads an article from any URL with Readability. You can also paste text directly.",
  ],
  [
    "Offline-first storage",
    "Lector stores data in SQLite on the server and in IndexedDB in the browser. It needs no cloud account and no sync.",
  ],
  [
    "Statistics dashboard",
    "The dashboard shows your vocabulary growth, your reading streaks, your activity heatmaps, and your cloze mastery. It also rates your fluency on the Common European Framework of Reference (CEFR) scale.",
  ],
  [
    "AI translation, with an offline backup",
    "When you need a translation, Lector calls Claude or a local LLM. If neither is available, it uses the on-device dictionary from the language pack.",
  ],
  [
    "Any language",
    "The reader works with any language. A language pack adds a cloze bank and a dictionary.",
  ],
];

const completeLanguages = languages
  .filter((language) => language.status === "complete")
  .map((language) => {
    const hasGuide = Boolean(languageGuides[language.slug]);
    return {
      ...language,
      href: hasGuide
        ? `/languages/${language.slug}/`
        : `/reference-data/${language.slug}/`,
      action: hasGuide
        ? `Learn ${language.name.split("→")[0].trim()}`
        : "View reference data",
    };
  });

const roadmapLanguages = languages.filter(
  (language) => language.status === "coming-soon",
);

// Options for the interest form under the roadmap grid. `endonym` leads,
// because `name` carries the "→ English" direction that the label does not need.
const notifyOptions = roadmapLanguages.map((language) => ({
  slug: language.slug,
  name: `${language.endonym} (${language.name.replace(" → English", "")})`,
}));

const faqs = [
  {
    question: "Is it really free?",
    answer:
      "If you host it yourself, Lector is free and open-source. Deploy it on your own machine, with optional authentication. There is no subscription and there are no feature gates. If you do not run a local model, your only cost is your own use of an LLM API. If you prefer not to run a server, Lector Cloud starts at $5/mo and we host it for you. For comparison, LingQ costs about $15/mo and Clozemaster Pro about $13/mo.",
  },
  {
    question: "Self-host or Lector Cloud. Which is right for me?",
    answer:
      "If you can run a Docker container, host Lector yourself. It costs nothing, your data never leaves your hardware, and you bring your own LLM keys. If you prefer to read and let someone else handle the servers, Lector Cloud does that from $5/mo. We also handle the backups and the updates. You can move between the two at any time. Export your data whenever you want to, because you always own it.",
  },
  {
    question: "Where does my data live?",
    answer:
      "The answer depends on how you run Lector. If you host it yourself, all your data stays on your hardware in a Docker volume, and a backup is one file copy. There are no third-party databases, no analytics, and no telemetry. To let us count the active self-hosted installations, you may opt in and send us a signal. On Lector Cloud, we host your data in AWS (us-east-1). You can export it at any time, and you always own it.",
  },
  {
    question: "Do I need an API key or a GPU?",
    answer:
      "No. The reader, the cloze practice, and the vocabulary tracking all work offline against a built-in dictionary. Only three features use the network: AI translation, the tutor, and writing correction. You can point those three at a local model or at any OpenAI-compatible API. Ollama, Llama, and Gemma all work.",
  },
  {
    question: "Which languages does Lector support?",
    answer: `The reader works with any language. A language pack adds a frequency-ordered cloze bank and an on-device dictionary. The packs now cover ${completeLanguages
      .map((l) => l.endonym)
      .join(
        ", ",
      )}. We add more packs over time. To add a new pair, send a simple pull request.`,
  },
  {
    question: "How do I get help?",
    answer:
      "Open the <a href='/contact/'>contact page</a>. Send a message. You can also email support@lector.dev. The Discord server is another option.",
  },
  {
    question: "How is this different from LingQ, Clozemaster, or Anki?",
    answer:
      "Lector does the work of both LingQ and Clozemaster in one place. It keeps all your known words in one vocabulary database, and not spread across separate services. You still own your cards in Anki. Lector gives you LingQ-style reading with click-to-translate, Clozemaster-style frequency cloze, two-way Anki sync, an LLM tutor, and a writing journal. You run one app on your own server, and you own your data. See the full comparisons: <a href='/vs/lingq/'>Lector vs LingQ</a>, <a href='/vs/clozemaster/'>Lector vs Clozemaster</a>, <a href='/vs/lute/'>Lector vs Lute</a>, <a href='/vs/linguacafe/'>Lector vs LinguaCafe</a>, and <a href='/vs/freelingo/'>Lector vs FreeLingo</a>.",
  },
];
---

<Base
  title="Lector | a self-hosted reader for language learners"
  description="A self-hosted reader for language learners, with LingQ-style reading, Clozemaster-style cloze practice, and AnkiConnect integration. You keep your books and your data."
  schema={[softwareApplicationSchema(), faqPageSchema(faqs)]}
>
  <!-- Hero -->
  <section class="pt-14 pb-20 sm:pt-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <Eyebrow>Open source &middot; self-host or Lector Cloud</Eyebrow>
      <Heading class="max-w-4xl text-5xl/[1.05] sm:text-7xl/[1.05]">
        Read your way into a <span class="italic">new language</span>.
      </Heading>
      <Text size="lg" class="max-w-2xl text-pretty">
        Lector turns the books, articles, videos, and podcasts you choose into a
        complete course. Click any word to translate it. Mine vocabulary as you read.
        Practise it with frequency-ordered cloze. Send it to Anki. Run Lector on
        your own hardware, or on Lector Cloud.
      </Text>
      <div class="mt-2 flex flex-col items-center gap-3">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg">Start on Lector Cloud</Button>
          <Button href="/docs/installation/" variant="soft" size="lg">
            Self-host, free
          </Button>
        </div>
      </div>
    </Container>

    <Container class="mt-14">
      <div
        class="mx-auto max-w-5xl rounded-2xl bg-olive-950/2.5 p-2 ring-1 ring-olive-950/5 dark:bg-white/5 dark:ring-white/10"
      >
        <img
          src="/images/reader.png"
          alt="Lector reader view with click-to-translate and word-state colouring"
          width="1600"
          height="1000"
          data-zoomable
          class="w-full rounded-xl ring-1 ring-black/10"
        />
      </div>
    </Container>
  </section>

  <!-- Feature moments -->
  <section class="py-12">
    <Container class="flex flex-col gap-6">
      {
        moments.map((m, i) => (
          <div class="grid grid-cols-1 items-center gap-8 rounded-2xl bg-olive-950/2.5 p-6 sm:p-10 lg:grid-cols-2 lg:gap-14 dark:bg-white/5">
            <div
              class:list={["flex flex-col gap-4", i % 2 === 1 && "lg:order-2"]}
            >
              <Eyebrow>{m.eyebrow}</Eyebrow>
              <Subheading class="text-3xl/9 sm:text-4xl/12">
                {m.title}
              </Subheading>
              <Text class="text-pretty">{m.body}</Text>
            </div>
            <div class:list={[i % 2 === 1 && "lg:order-1"]}>
              <img
                src={m.img}
                alt={m.alt}
                loading="lazy"
                data-zoomable
                class="w-full rounded-xl ring-1 ring-black/10"
              />
            </div>
          </div>
        ))
      }
    </Container>
  </section>

  <!-- Everything else -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Also included</Eyebrow>
        <Subheading>Everything else, without the sprawl.</Subheading>
      </div>
      <div
        class="grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          extras.map(([title, body]) => (
            <div class="flex flex-col gap-2 border-t border-olive-950/10 pt-4 dark:border-white/10">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">{body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Languages -->
  <section id="languages" class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Language packs</Eyebrow>
        <Subheading>Languages, ready to read.</Subheading>
        <Text class="text-pretty">
          Each language pack contains a frequency-ordered cloze bank and an
          on-device dictionary. Every pack has the same depth.
        </Text>
      </div>

      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          completeLanguages.map((lang) => (
            <a
              href={lang.href}
              class="group flex flex-col gap-3 rounded-xl bg-olive-950/2.5 p-6 transition-colors hover:bg-olive-950/5 dark:bg-white/5 dark:hover:bg-white/10"
            >
              <span class="text-3xl">{lang.flag}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-2xl/7 text-olive-950 dark:text-white">
                  {lang.name}
                </h3>
                <p class="text-sm/6 text-olive-600 dark:text-olive-400">
                  {lang.endonym}
                </p>
              </div>
              <span class="mt-auto inline-flex items-center gap-1 text-sm/7 font-medium text-olive-950 group-hover:text-sage-700 dark:text-white dark:group-hover:text-sage-300">
                {lang.action}
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  class="size-4 transition-transform group-hover:translate-x-0.5"
                >
                  <path
                    d="M6.5 3.5 11 8l-4.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
      <Subheading>On the roadmap.</Subheading>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          roadmapLanguages.map((lang) => (
            <div class="flex flex-col gap-3 rounded-xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <span class="text-3xl opacity-60">{lang.flag}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-2xl/7 text-olive-950 dark:text-white">
                  {lang.name}
                </h3>
                <p class="text-sm/6 text-olive-600 dark:text-olive-400">
                  {lang.endonym}
                </p>
              </div>
              <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1">
                <button
                  type="button"
                  class="text-sm/7 font-medium text-olive-950 underline underline-offset-4 hover:text-sage-700 dark:text-white dark:hover:text-sage-300"
                  data-notify-language={lang.slug}
                >
                  Notify me
                </button>
                {/* Filled by LanguageNotify only above the public threshold. */}
                <span
                  class="text-sm/7 text-olive-600 dark:text-olive-400"
                  data-language-count={lang.slug}
                  hidden
                />
              </div>
            </div>
          ))
        }
      </div>

      <LanguageNotify options={notifyOptions}>
        <p class="max-w-lg text-sm/6 text-olive-600 dark:text-olive-500">
          A new language is simple to add. To build a pack yourself, open the{" "}
          <a
            href={GITHUB}
            target="_blank"
            rel="noopener"
            class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
            >GitHub repository</a
          >.
        </p>
      </LanguageNotify>
    </Container>
  </section>

  <!-- Two ways to run it -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Two ways to run it</Eyebrow>
        <Subheading>Open source. Your way.</Subheading>
        <Text class="text-pretty">
          You get the same app in both cases. Host it yourself for free, or let
          us run it for you.
        </Text>
      </div>
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
        <div
          class="flex flex-col gap-4 rounded-2xl bg-olive-950/2.5 p-8 dark:bg-white/5"
        >
          <div class="flex items-center gap-3">
            <h3 class="font-display text-2xl/8 text-olive-950 dark:text-white">
              Self-host
            </h3>
            <span
              class="inline-flex rounded-full bg-sage-600/15 px-2.5 py-0.5 text-xs font-medium text-sage-700 dark:text-sage-300"
            >
              Free
            </span>
          </div>
          <Text class="flex-1 text-pretty">
            Run the Docker image on your own hardware. Your data never leaves
            your server. You bring your own LLM keys, or you run a local model.
            Lector is free forever.
          </Text>
          <ActionLink href="/docs/installation/">Read the setup docs</ActionLink
          >
        </div>

        <div
          class="flex flex-col gap-4 rounded-2xl bg-olive-950 p-8 text-white dark:bg-white/10 dark:ring-1 dark:ring-white/10"
        >
          <div class="flex items-center gap-3">
            <h3 class="font-display text-2xl/8 text-white">Lector Cloud</h3>
            <span
              class="inline-flex rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium text-white"
            >
              Beta &middot; from $5/mo
            </span>
          </div>
          <p class="flex-1 text-pretty text-base/7 text-olive-200">
            We host it, back it up, and keep it updated. You need no Docker and
            no setup. Just sign in and start to read. If you prefer not to run a
            server, choose Lector Cloud.
          </p>
          <a
            href={SIGNUP_URL}
            class="group inline-flex items-center gap-2 text-sm/7 font-medium text-white"
          >
            Start on Lector Cloud
            <svg
              viewBox="0 0 16 16"
              fill="none"
              class="size-4 transition-transform group-hover:translate-x-0.5"
            >
              <path
                d="M6.5 3.5 11 8l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why self-host -->
  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-4">
        <Eyebrow>Why self-host</Eyebrow>
        <Subheading
          >Your course should not rent your progress back to you.</Subheading
        >
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            [
              "Your data, your server",
              "Reading history, vocabulary, and progress live in a SQLite file on your hardware. There are no third parties and no telemetry.",
            ],
            [
              "No subscriptions",
              "Deploy Lector once. Then learn forever. There are no monthly fees, no premium tiers, and no feature gates.",
            ],
            [
              "Works offline",
              "Reading, cloze, and vocabulary all run without a connection. Only AI features need the internet.",
            ],
            [
              "Simple backup",
              "Your data is one SQLite file in one Docker volume. Copy it with rsync or borg, or copy it to a USB drive.",
            ],
          ].map(([title, body]) => (
            <div class="flex flex-col gap-2 rounded-xl bg-olive-950/2.5 p-6 dark:bg-white/5">
              <h3 class="text-base/7 font-semibold text-olive-950 dark:text-white">
                {title}
              </h3>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">{body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Quick install -->
  <section id="install" class="py-16">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col gap-6">
        <Eyebrow>Get started</Eyebrow>
        <Subheading>Ready in about a minute.</Subheading>
        <Text class="text-pretty">
          Lector needs one Docker container and one volume. Copy this into a
          <code
            class="rounded bg-olive-950/10 px-1.5 py-0.5 font-mono text-[0.85em] dark:bg-white/10"
            >docker-compose.yml</code
          >
          file. Then start the container.
        </Text>
        <div class="flex flex-wrap gap-3">
          <Button href="/docs/installation/" size="lg">Read the docs</Button>
          <ActionLink href="/docs/configuration/"
            >Configuration and environment variables</ActionLink
          >
        </div>
      </div>
      <div
        class="overflow-x-auto rounded-2xl bg-olive-950 p-6 font-mono text-sm/6 text-olive-100 ring-1 ring-black/10 dark:bg-black/40"
      >
        <pre><code><span class="text-olive-400"># Create a directory for Lector</span>
mkdir lector && cd lector

<span class="text-olive-400"># Create a docker-compose.yml</span>
cat &lt;&lt;EOF &gt; docker-compose.yml
services:
  lector:
    image: ghcr.io/heuwels/lector:latest
    container_name: lector
    restart: unless-stopped
    ports:
      - "3400:3000"
    environment:
      - NODE_ENV=production
    volumes:
      - ./data:/app/data
EOF

<span class="text-olive-400"># Start it up</span>
docker compose up -d</code></pre>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <Container class="grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      <div class="flex max-w-md flex-col gap-4">
        <Eyebrow>Questions</Eyebrow>
        <Subheading>Good to know.</Subheading>
        <Text class="text-pretty">
          Still curious? The <a
            href="/docs/"
            class="font-medium underline underline-offset-4">docs</a
          >{" "}
          cover installation, reverse proxies, AnkiConnect, and every environment
          variable.
        </Text>
      </div>
      <Faqs items={faqs} />
    </Container>
  </section>

  <!-- Community -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col items-center gap-6 rounded-2xl bg-olive-950/2.5 px-6 py-12 text-center dark:bg-white/5"
      >
        <Eyebrow>Get involved</Eyebrow>
        <Subheading class="max-w-2xl">Learn alongside other readers.</Subheading
        >
        <Text class="max-w-xl text-pretty">
          Join our Discord server. There you can share resources, compare
          progress, ask for new languages, and tell us what to build next.
        </Text>
        <Button href={DISCORD} variant="soft" target="_blank" rel="noopener">
          Join the Discord server
        </Button>
      </div>
    </Container>
  </section>

  <!-- Final CTA -->
  <section class="py-16">
    <Container>
      <div
        class="flex flex-col items-center gap-8 rounded-3xl bg-olive-950 px-6 py-16 text-center dark:bg-white/5 dark:ring-1 dark:ring-white/10"
      >
        <Heading
          color="light"
          class="max-w-3xl text-4xl/[1.1] sm:text-6xl/[1.1]"
        >
          Start to read in your <span class="italic">target language</span> today.
        </Heading>
        <p class="max-w-xl text-pretty text-lg/8 text-olive-300">
          Host the open-source app yourself for free, or sign in to Lector Cloud
          and start.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={SIGNUP_URL} size="lg" color="light"
            >Start on Lector Cloud</Button
          >
          <Button
            href="/docs/installation/"
            variant="plain"
            size="lg"
            color="light"
          >
            Self-host, free
          </Button>
        </div>
      </div>
    </Container>
  </section>
</Base>
