---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Subheading from "../../components/Subheading.astro";
import Button from "../../components/Button.astro";

import {
  CLOUD_CHECKOUT_URL,
  CLOUD_PLUS_CHECKOUT_URL,
  GITHUB,
} from "../../data/links";

// Lector Cloud has no Free plan for a new account. The first month of a
// monthly plan costs $1, and the app applies that price at checkout. Paid
// links carry the selected plan through account creation into the app's
// server-created Paddle checkout. Self-hosted remains free, open source, and
// unlimited. The per-plan numbers
// below mirror the API's DEFAULT_PLAN_LIMITS (api/src/lib/entitlements.ts) —
// keep them in sync when the entitlements engine changes.
const tiers = [
  {
    name: "Cloud",
    price: "$5",
    period: "/month",
    badge: "$1 first month",
    tagline:
      "We host it for you — no Docker, no setup. For when you'd rather just read.",
    features: [
      "The full reader, cloze practice, vocabulary mining, and Anki sync",
      "Fully managed — nothing to install",
      "5,000 managed AI requests a month — tap-to-translate, chat tutor & journal correction",
      "10,000 AI dictionary glosses a month",
      "300,000 characters a month of high-quality managed voices",
      "Import podcasts: 5 hours of audio transcribed a month, with a listen-along & shadowing player",
      "Room for 1,000 texts and 5,000 journal words a month",
      "Automatic backups & updates, and email support",
    ],
    note: "Your first month costs $1. Or pay $50/year — two months free",
    cta: { label: "Start Cloud for $1", href: CLOUD_CHECKOUT_URL },
    featured: true,
  },
  {
    name: "Cloud Plus",
    price: "$12",
    period: "/month",
    badge: "$1 first month",
    tagline: "For heavy readers who want the whole thing handled.",
    features: [
      "Everything in Cloud",
      "20,000 managed AI requests and 50,000 AI glosses a month",
      "1,500,000 characters a month of managed voices",
      "15 hours of podcast transcription a month",
      "Unlimited journal writing, library, and phrase length",
      "Priority support",
      "Early access to new language packs",
    ],
    note: "Your first month costs $1. Or pay $120/year — two months free",
    cta: { label: "Start Cloud Plus for $1", href: CLOUD_PLUS_CHECKOUT_URL },
    featured: false,
  },
  {
    name: "Self-hosted",
    price: "$0",
    period: "forever",
    badge: "Free & open source",
    tagline: "Run it yourself. Your server, your data, no account.",
    features: [
      "Every feature — reader, cloze, mining, journal, tutor",
      "Unlimited everything, no caps",
      "Your data never leaves your hardware",
      "Bring your own LLM keys, or run a fully local model",
      "Community support on GitHub & Discord",
    ],
    cta: { label: "Self-host for free", href: "/docs/installation/" },
    featured: false,
  },
];

// Full per-plan entitlements. A cell is `true` (included), `false` (not
// included), or a string. Columns are Cloud · Cloud Plus · Self-hosted.
type Cell = boolean | string;
interface CompareRow {
  label: string;
  cloud: Cell;
  plus: Cell;
  self: Cell;
}
interface CompareGroup {
  title: string;
  rows: CompareRow[];
}
const planCols = ["Cloud", "Cloud Plus", "Self-hosted"];
const comparison: CompareGroup[] = [
  {
    title: "Reading & library",
    rows: [
      { label: "Texts you can import", cloud: "1,000", plus: "Unlimited", self: "Unlimited" },
      { label: "Collections", cloud: "50", plus: "Unlimited", self: "Unlimited" },
      { label: "Words per phrase lookup", cloud: "9", plus: "Unlimited", self: "Unlimited" },
    ],
  },
  {
    title: "Translation & dictionary",
    rows: [
      { label: "On-device dictionary", cloud: true, plus: true, self: true },
      { label: "Tap-to-translate", cloud: "Included", plus: "Included", self: "Unlimited" },
      { label: "AI dictionary glosses", cloud: "10,000 / mo", plus: "50,000 / mo", self: "Unlimited" },
    ],
  },
  {
    title: "AI features — chat tutor, journal correction, rich translation",
    rows: [
      { label: "Managed AI requests", cloud: "5,000 / mo", plus: "20,000 / mo", self: "Unlimited" },
      { label: "Bring your own AI key (optional)", cloud: true, plus: true, self: true },
    ],
  },
  {
    title: "Speech",
    rows: [
      { label: "Free browser voices", cloud: true, plus: true, self: true },
      { label: "Managed premium voices", cloud: "300,000 chars / mo", plus: "1,500,000 chars / mo", self: "Your own key" },
    ],
  },
  {
    title: "Podcasts & listening",
    rows: [
      { label: "YouTube transcript import", cloud: true, plus: true, self: true },
      { label: "Podcast import with listen-along & shadowing player", cloud: true, plus: true, self: true },
      { label: "Audio transcription", cloud: "5 hours / mo", plus: "15 hours / mo", self: "Your own Whisper" },
      { label: "Audio storage", cloud: "2 GB", plus: "10 GB", self: "Unlimited" },
    ],
  },
  {
    title: "Writing",
    rows: [
      { label: "Journal writing", cloud: "5,000 words / mo", plus: "Unlimited", self: "Unlimited" },
    ],
  },
  {
    title: "Vocabulary & data",
    rows: [
      { label: "Saved vocabulary & progress", cloud: "Unlimited", plus: "Unlimited", self: "Unlimited" },
      { label: "Anki sync", cloud: true, plus: true, self: true },
      { label: "Export your data anytime", cloud: true, plus: true, self: true },
    ],
  },
  {
    title: "Cloud operations",
    rows: [
      { label: "Automatic backups & updates", cloud: true, plus: true, self: "You manage" },
      { label: "Support", cloud: "Email", plus: "Priority", self: "Community" },
    ],
  },
];
---

<Base
  title="Pricing | Lector"
  description="Try Lector Cloud for $1 for the first month, or self-host the open-source app for free."
>
  <PageHeader
    title="Pricing"
    description="Try Lector Cloud for $1 for your first month, or self-host the open-source app for free, forever."
  >
    <Fragment slot="breadcrumb">
      <a href="/" class="hover:text-olive-950 dark:hover:text-white">lector</a> /
      pricing
    </Fragment>
  </PageHeader>

  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <div
              class:list={[
                "flex flex-col gap-6 rounded-2xl p-6 sm:p-8",
                tier.featured
                  ? "bg-olive-950 text-white dark:bg-white/10 dark:ring-1 dark:ring-white/10"
                  : "bg-olive-950/2.5 dark:bg-white/5",
              ]}
            >
              <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between gap-2">
                  <h2
                    class:list={[
                      "font-display text-2xl/8 tracking-tight",
                      tier.featured
                        ? "text-white"
                        : "text-olive-950 dark:text-white",
                    ]}
                  >
                    {tier.name}
                  </h2>
                  {tier.badge && (
                    <span
                      class:list={[
                        "inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium",
                        tier.featured
                          ? "bg-white/15 text-white"
                          : "bg-olive-950/10 text-olive-700 dark:bg-white/10 dark:text-olive-300",
                      ]}
                    >
                      {tier.badge}
                    </span>
                  )}
                </div>

                <p class="flex items-baseline gap-1">
                  <span
                    class:list={[
                      "font-display text-4xl tracking-tight",
                      tier.featured
                        ? "text-white"
                        : "text-olive-950 dark:text-white",
                    ]}
                  >
                    {tier.price}
                  </span>
                  <span
                    class:list={[
                      "text-sm/7",
                      tier.featured ? "text-olive-300" : "text-olive-500",
                    ]}
                  >
                    {tier.period}
                  </span>
                </p>

                <p
                  class:list={[
                    "text-sm/6 text-pretty",
                    tier.featured
                      ? "text-olive-200"
                      : "text-olive-700 dark:text-olive-400",
                  ]}
                >
                  {tier.tagline}
                </p>

                <ul class="mt-2 flex flex-col gap-3">
                  {tier.features.map((f) => (
                    <li class="flex gap-3">
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                        class:list={[
                          "mt-1 size-4 shrink-0",
                          tier.featured
                            ? "text-white"
                            : "text-olive-950 dark:text-white",
                        ]}
                      >
                        <path
                          d="M13 4.5 6.5 11 3.5 8"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span
                        class:list={[
                          "text-sm/6",
                          tier.featured
                            ? "text-olive-100"
                            : "text-olive-700 dark:text-olive-400",
                        ]}
                      >
                        {f}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-auto flex flex-col gap-2">
                {tier.note && (
                  <p
                    class:list={[
                      "text-center text-xs",
                      tier.featured ? "text-olive-400" : "text-olive-500",
                    ]}
                  >
                    {tier.note}
                  </p>
                )}
                {tier.cta.href ? (
                  <Button
                    href={tier.cta.href}
                    size="lg"
                    color={tier.featured ? "light" : "dark/light"}
                    class="w-full"
                  >
                    {tier.cta.label}
                  </Button>
                ) : (
                  <span class="inline-flex w-full cursor-default items-center justify-center rounded-full bg-olive-950/10 px-4 py-2 text-sm/7 font-medium text-olive-500 dark:bg-white/10 dark:text-olive-400">
                    {tier.cta.label}
                  </span>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <p
        class="rounded-xl border border-olive-950/10 px-6 py-4 text-center text-base/7 text-olive-700 dark:border-white/10 dark:text-olive-400"
        data-testid="pricing-self-host-note"
      >
        <span class="font-semibold text-olive-950 dark:text-white"
          >Do you want Lector for free?</span
        >{" "}
        Host it yourself. You get every feature, with no limits and no account.{" "}
        <a
          href="/docs/installation/"
          class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
          >Read the install guide</a
        >.
      </p>

      <div class="flex flex-col gap-6">
        <Subheading>Compare plans</Subheading>
        <p class="max-w-3xl text-base/7 text-olive-700 dark:text-olive-400">
          Every plan includes the full reader, cloze practice, vocabulary
          mining, and Anki sync. The cloud plans add managed AI and premium
          voices so there's nothing to set up; self-hosting lifts every cap.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[48rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-olive-950/15 dark:border-white/15">
                <th
                  scope="col"
                  class="py-3 pr-4 text-sm font-medium text-olive-600 dark:text-olive-400"
                >
                  Feature
                </th>
                {
                  planCols.map((name) => (
                    <th
                      scope="col"
                      class="px-4 py-3 text-center font-display text-lg/6 tracking-tight text-olive-950 dark:text-white"
                    >
                      {name}
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((group) => (
                  <Fragment>
                    <tr>
                      <th
                        scope="colgroup"
                        colspan={4}
                        class="pt-8 pb-2 text-xs font-semibold tracking-wide text-olive-500 uppercase dark:text-olive-400"
                      >
                        {group.title}
                      </th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr class="border-t border-olive-950/10 dark:border-white/10">
                        <th
                          scope="row"
                          class="py-3 pr-4 text-sm/6 font-normal text-olive-700 dark:text-olive-300"
                        >
                          {row.label}
                        </th>
                        {[row.cloud, row.plus, row.self].map((cell) => (
                          <td class="px-4 py-3 text-center text-sm/6 text-olive-700 tabular-nums dark:text-olive-400">
                            {cell === true ? (
                              <Fragment>
                                <svg
                                  viewBox="0 0 16 16"
                                  fill="none"
                                  aria-hidden="true"
                                  class="mx-auto size-4 text-sage-600 dark:text-sage-400"
                                >
                                  <path
                                    d="M13 4.5 6.5 11 3.5 8"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>
                                <span class="sr-only">Included</span>
                              </Fragment>
                            ) : cell === false ? (
                              <Fragment>
                                <span
                                  aria-hidden="true"
                                  class="text-olive-300 dark:text-olive-600"
                                >
                                  &ndash;
                                </span>
                                <span class="sr-only">Not included</span>
                              </Fragment>
                            ) : (
                              cell
                            )}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </Fragment>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="max-w-3xl text-sm/6 text-olive-600 dark:text-olive-500">
          On the paid plans, tap-to-translate, the chat tutor, and journal
          correction all draw from one monthly managed AI-requests allowance;
          dictionary glosses have their own. Limits are generous fair-use ceilings —
          an ordinary learner won't hit them.
        </p>
      </div>

      <div
        class="flex flex-col gap-3 rounded-xl border border-olive-950/10 p-6 text-sm/7 text-olive-700 sm:p-8 dark:border-white/10 dark:text-olive-400"
      >
        <p>
          <span class="font-semibold text-olive-950 dark:text-white"
            >Self-hosting is free and always will be.</span
          > The cloud plans are for people who'd rather not run Docker, and they
          fund future development. Your first month of a monthly plan costs $1.
          Then the plan renews at its usual price, and you can cancel at any time.
          If you're running self-hosted but you'd like to support, you can send a
          one-time tip or sign up as a supporter on an ongoing basis. Support <a
            href="/support">here</a
          >.
        </p>
        <p>
          No lock-in: export your data whenever you like. Prefer your own LLM
          keys on a cloud plan? Flip the bring-your-own-key toggle — it lifts
          the usage caps at the same price.
        </p>
        <p>
          Questions about a plan? <a
            href="/docs/"
            class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
            >Read the docs</a
          > or <a
            href={GITHUB}
            target="_blank"
            rel="noopener"
            class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
            >ask on GitHub</a
          >.
        </p>
      </div>
    </Container>
  </section>
</Base>
