---
import Base from "../../layouts/Base.astro";

const sections: {
  label: string;
  pages: { href: string; title: string; blurb: string }[];
}[] = [
  {
    label: "Getting started",
    pages: [
      {
        href: "/docs/installation/",
        title: "Installation",
        blurb: "Run Lector with Docker Compose in two minutes — ports, volumes, updating.",
      },
      {
        href: "/docs/configuration/",
        title: "Configuration",
        blurb: "The full environment-variable reference: core, AI providers, TTS, accounts.",
      },
    ],
  },
  {
    label: "Guides",
    pages: [
      {
        href: "/docs/compose-env-vars/",
        title: "Compose + env vars",
        blurb: "Keep secrets out of your compose file with .env — version pinning, defaults, verification.",
      },
      {
        href: "/docs/backups/",
        title: "Backups",
        blurb: "From a one-line tar to the nightly staged-and-offsite system we run ourselves.",
      },
      {
        href: "/docs/multi-user-oidc/",
        title: "Multi-user & OIDC",
        blurb: "Per-user libraries with SSO through Google, Authentik, Keycloak, or any OIDC provider.",
      },
      {
        href: "/docs/self-hosting/",
        title: "Tailscale & HTTPS",
        blurb: "Private access over your tailnet, and same-origin HTTPS with Caddy.",
      },
    ],
  },
  {
    label: "Using Lector",
    pages: [
      {
        href: "/docs/features/",
        title: "Reading & practice",
        blurb: "EPUBs and articles, click-to-translate, word states, cloze SRS, AI providers, AnkiConnect.",
      },
      {
        href: "/docs/languages/",
        title: "Supported languages",
        blurb: "Language packs, sentence banks, and how the frequency data is built.",
      },
    ],
  },
];
---
<Base title="Documentation | Lector" description="Installation guide, configuration, and self-hosting documentation for Lector.">

<header class="docs-header">
  <div class="container">
    <p class="breadcrumb"><a href="/">lector</a> / docs</p>
    <h1>Documentation</h1>
  </div>
</header>

<div class="container">
  <main class="docs-body docs-index">
    <p class="docs-intro">Everything here assumes the Docker image &mdash; a single container, a bind-mounted data directory, and configuration by environment variable. New here? Start with <a href="/docs/installation/">Installation</a>.</p>

    {
      sections.map((section) => (
        <section class="docs-section">
          <h2>{section.label}</h2>
          <div class="docs-grid">
            {section.pages.map((page) => (
              <a class="docs-card" href={page.href}>
                <h3>{page.title}</h3>
                <p>{page.blurb}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section class="docs-section">
      <h2>Tech stack</h2>
      <ul>
        <li><strong>Frontend:</strong> Next.js 16 with React 19 &mdash; UI only; the browser calls the API directly</li>
        <li><strong>API:</strong> Hono on Bun, using <code>bun:sqlite</code></li>
        <li><strong>Database:</strong> SQLite, server-side only</li>
        <li><strong>Styling:</strong> Tailwind CSS v4</li>
        <li><strong>AI:</strong> Anthropic Claude, or any OpenAI-compatible server &mdash; Ollama, LM Studio, vLLM (all optional)</li>
        <li><strong>TTS:</strong> Google Cloud Text-to-Speech (optional)</li>
        <li><strong>Container:</strong> Docker (single image, bind mount for data)</li>
      </ul>
    </section>
  </main>
</div>

<style>
  .docs-index {
    padding-bottom: 4rem;
  }
  .docs-intro {
    max-width: 62ch;
  }
  .docs-section {
    margin-top: 2.5rem;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 720px) {
    .docs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .docs-card {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .docs-card:hover {
    border-color: var(--text-muted);
    text-decoration: none;
  }
  .docs-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    color: var(--text);
  }
  .docs-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>

</Base>
