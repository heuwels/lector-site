---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import LanguageNotify from "../../components/LanguageNotify.astro";
import { languages } from "../../data/languages";

const available = languages.filter((l) => l.status !== "coming-soon");
const comingSoon = languages.filter((l) => l.status === "coming-soon");

// The form offers every language that is not ready yet. `endonym` is a clearer
// label than `name` here, because `name` carries the "→ English" direction.
const notifyOptions = comingSoon.map((lang) => ({
  slug: lang.slug,
  name: `${lang.endonym} (${lang.name.replace(" → English", "")})`,
}));
---

<Base
  title="Reference Data | Lector"
  description="Downloadable language reference data for Lector: frequency-banded Anki decks and word frequency lists, per supported language."
>
  <PageHeader
    title="Reference data"
    description="Open, downloadable data behind Lector's language packs — frequency-banded Anki decks and word-frequency lists, built from public corpora. Free to use under the licence noted on each page."
  >
    <Fragment slot="breadcrumb">
      <a href="/" class="hover:text-olive-950 dark:hover:text-white">lector</a> /
      reference data
    </Fragment>
  </PageHeader>

  <section class="py-16">
    <Container class="flex flex-col gap-10">
      <p class="max-w-2xl text-base/7 text-olive-700 dark:text-olive-400">
        Each language page has the sources, the frequency bands, and the
        downloads for that pack. The{" "}
        <a href="/methodology/" class="font-medium underline underline-offset-4"
          >methodology page</a
        >{" "}
        explains the method. The{" "}
        <a href="/free/" class="font-medium underline underline-offset-4"
          >free resources page</a
        >{" "}
        has files that you can download now.
      </p>

      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          available.map((lang) => (
            <a
              href={`/reference-data/${lang.slug}/`}
              class="group flex flex-col gap-3 rounded-xl bg-olive-950/2.5 p-6 transition-colors hover:bg-olive-950/5 dark:bg-white/5 dark:hover:bg-white/10"
            >
              <span class="text-3xl">{lang.flag}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-2xl/7 text-olive-950 dark:text-white">
                  {lang.name}
                </h3>
                <p class="text-sm/6 text-olive-600 dark:text-olive-400">
                  {lang.endonym}
                </p>
              </div>
              <p class="text-sm/7 text-olive-700 dark:text-olive-400">
                {lang.blurb}
              </p>
              <span class="mt-auto inline-flex items-center gap-1 pt-1 text-sm/7 font-medium text-olive-950 group-hover:text-sage-700 dark:text-white dark:group-hover:text-sage-300">
                View reference data
                <svg viewBox="0 0 16 16" fill="none" class="size-4 transition-transform group-hover:translate-x-0.5">
                  <path d="M6.5 3.5 11 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
        {
          comingSoon.map((lang) => (
            <div class="flex flex-col gap-3 rounded-xl border border-dashed border-olive-950/15 p-6 dark:border-white/15">
              <span class="text-3xl opacity-60">{lang.flag}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-2xl/7 text-olive-700 dark:text-olive-300">
                  {lang.name}
                </h3>
                <p class="text-sm/6 text-olive-500">{lang.endonym}</p>
              </div>
              <p class="text-sm/7 text-olive-600 dark:text-olive-500">
                {lang.blurb}
              </p>
              <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1">
                <button
                  type="button"
                  class="text-sm/7 font-medium text-olive-950 underline underline-offset-4 hover:text-sage-700 dark:text-white dark:hover:text-sage-300"
                  data-notify-language={lang.slug}
                >
                  Notify me
                </button>
                {/* Filled by LanguageNotify only above the public threshold. */}
                <span
                  class="text-sm/7 text-olive-500"
                  data-language-count={lang.slug}
                  hidden
                ></span>
              </div>
            </div>
          ))
        }
      </div>

      <p class="max-w-2xl text-sm/7 text-olive-600 dark:text-olive-500">
        The reader works with any language. A pack adds the sentence banks and
        the dictionaries. Ask for the language you want. We build the packs
        that the most people ask for.
      </p>

      <LanguageNotify options={notifyOptions} />
    </Container>
  </section>
</Base>
