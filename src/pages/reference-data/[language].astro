---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Subheading from "../../components/Subheading.astro";
import Button from "../../components/Button.astro";
import { languages } from "../../data/languages";

export function getStaticPaths() {
  // Complete + partial languages get a page. Partial ones (e.g. German) may have
  // no Lector data yet but still link recommended community decks.
  return languages
    .filter((l) => l.status !== "coming-soon")
    .map((l) => ({ params: { language: l.slug }, props: { lang: l } }));
}

const { lang } = Astro.props;
const maxBand = Math.max(1, ...(lang.bands?.map((b) => b.count) ?? []));

const cardClass =
  "flex flex-col rounded-xl bg-olive-950/2.5 p-6 dark:bg-white/5";
const tagClass =
  "inline-block rounded-full bg-olive-950/10 px-2.5 py-0.5 text-xs font-medium text-olive-700 dark:bg-white/10 dark:text-olive-300";
const metaClass = "text-xs text-olive-600 dark:text-olive-400";
---

<Base
  title={`${lang.endonym} reference data | Lector`}
  description={`${lang.endonym} reference data for Lector — ${
    lang.downloads.length
      ? "downloadable " +
        lang.downloads.map((d) => d.label.toLowerCase()).join(", ")
      : "data sources and recommended Anki decks"
  }.`}
>
  <PageHeader title={`${lang.flag} ${lang.endonym} reference data`}>
    <Fragment slot="breadcrumb">
      <a href="/" class="hover:text-olive-950 dark:hover:text-white">lector</a> /
      <a
        href="/reference-data/"
        class="hover:text-olive-950 dark:hover:text-white">reference data</a
      > / {lang.endonym}
    </Fragment>
  </PageHeader>

  <section class="py-16">
    <Container class="flex flex-col gap-14">
      <p class="max-w-3xl text-lg/8 text-olive-700 dark:text-olive-400">
        {lang.blurb}
      </p>

      {
        lang.downloads.length > 0 && (
          <div class="flex flex-col gap-6">
            <Subheading>Downloads</Subheading>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {lang.downloads.map((d) => (
                <div class={cardClass}>
                  <div class="mb-3 flex items-center justify-between gap-2">
                    <span class={tagClass}>{d.format}</span>
                    <span class={metaClass}>
                      {d.size} &middot; {d.license}
                    </span>
                  </div>
                  <h3 class="text-lg/7 font-semibold text-olive-950 dark:text-white">
                    {d.label}
                  </h3>
                  {d.note && (
                    <p class="mt-2 mb-5 flex-1 text-sm/7 text-olive-700 dark:text-olive-400">
                      {d.note}
                    </p>
                  )}
                  <Button href={d.file} download class="mt-auto self-start">
                    Download
                  </Button>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        lang.recommendedDecks && lang.recommendedDecks.length > 0 && (
          <div class="flex flex-col gap-6">
            <Subheading>Recommended Anki decks</Subheading>
            <p class="max-w-3xl text-base/7 text-olive-700 dark:text-olive-400">
              Free, community-made decks on AnkiWeb. People have dedicated a lot
              of time to these, and they're an excellent way to build a core
              vocabulary foundation. In Lector you'll mine your own specific
              cards from what you read — so think of these as the frequency-first
              base to start from.
            </p>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {lang.recommendedDecks.map((d) => (
                <div class={cardClass}>
                  <div class="mb-3 flex items-center justify-between gap-2">
                    <span class={tagClass}>AnkiWeb</span>
                    {d.meta && <span class={metaClass}>{d.meta}</span>}
                  </div>
                  <h3 class="text-lg/7 font-semibold text-olive-950 dark:text-white">
                    {d.label}
                  </h3>
                  <p class="mt-2 mb-5 flex-1 text-sm/7 text-olive-700 dark:text-olive-400">
                    {d.detail}
                  </p>
                  <Button
                    href={d.url}
                    variant="soft"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto self-start"
                  >
                    Open on AnkiWeb &rarr;
                  </Button>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        lang.stats.length > 0 && (
          <div class="flex flex-col gap-6">
            <Subheading>What's inside</Subheading>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
              {lang.stats.map((s) => (
                <div class="flex flex-col gap-1 rounded-xl bg-olive-950/2.5 p-5 dark:bg-white/5">
                  <span class="font-display text-2xl/8 text-olive-950 dark:text-white">
                    {s.value}
                  </span>
                  <span class="text-xs tracking-wide text-olive-600 uppercase dark:text-olive-400">
                    {s.label}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        lang.bands && (
          <div class="flex flex-col gap-4">
            <h3 class="font-display text-2xl/8 tracking-tight text-olive-950 dark:text-white">
              Anki deck — cards per frequency band
            </h3>
            <p class="max-w-3xl text-base/7 text-olive-700 dark:text-olive-400">
              The deck is split into six sub-decks by blended frequency. Study
              the most common words first (Core), then work down.
            </p>
            <div class="flex flex-col gap-2">
              {lang.bands.map((b) => (
                <div class="grid grid-cols-[6rem_1fr_3.5rem] items-center gap-3 text-sm">
                  <span class="text-right text-olive-600 dark:text-olive-400">
                    {b.name}
                  </span>
                  <span class="h-4 overflow-hidden rounded bg-olive-950/10 dark:bg-white/10">
                    <span
                      class="block h-full rounded bg-sage-600 dark:bg-sage-400"
                      style={`width: ${Math.round((b.count / maxBand) * 100)}%`}
                    />
                  </span>
                  <span class="text-right text-olive-600 tabular-nums dark:text-olive-400">
                    {b.count.toLocaleString()}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        lang.sources.length > 0 && (
          <div class="flex flex-col gap-6">
            <Subheading>Provenance &amp; licensing</Subheading>
            <p class="max-w-3xl text-base/7 text-olive-700 dark:text-olive-400">
              Built entirely from open data — nothing here is derived from
              copyrighted dictionaries. See the{" "}
              <a
                href="/methodology/#phase-1"
                class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
              >
                methodology
              </a>{" "}
              for how frequency drives vocabulary learning in Lector.
            </p>
            <ul class="flex max-w-3xl flex-col gap-3">
              {lang.sources.map((s) => (
                <li class="border-l-2 border-olive-950/10 pl-4 text-base/7 text-olive-700 dark:border-white/10 dark:text-olive-400">
                  <strong class="font-semibold text-olive-950 dark:text-white">
                    {s.label}:
                  </strong>{" "}
                  {s.detail}{" "}
                  {s.url ? (
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-olive-950 underline underline-offset-4 dark:text-white"
                    >
                      {s.license}
                    </a>
                  ) : (
                    <span class={metaClass}>{s.license}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </Container>
  </section>
</Base>
