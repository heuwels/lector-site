---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ImageZoom from "../components/ImageZoom.astro";
import { GITHUB, DISCORD } from "../data/links";

interface Props {
  title: string;
  description?: string;
  /** OG/Twitter preview image (root-relative or absolute). Defaults to the reader shot. */
  image?: string;
  /** OpenGraph type — "website" (default) or "article". */
  ogType?: "website" | "article";
  /** Page-specific JSON-LD (object or array). Organization + WebSite are always emitted. */
  schema?: object | object[];
  /** Built AVIF URL to preload as LCP. Homepage hero only. */
  lcpImage?: string;
}

const {
  title,
  description = "A self-hosted language learning reader with LingQ-style reading, Clozemaster-style cloze practice, and AnkiConnect integration. Your books, your data.",
  image = "/images/reader.png",
  ogType = "website",
  schema,
  lcpImage,
} = Astro.props;

// Absolute URLs for canonical + social tags (site = https://lector.dev).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Sitewide identity graph; any page-specific schema is appended.
const schemaGraph = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Lector",
    url: Astro.site?.href,
    logo: new URL("/logo.svg", Astro.site).href,
    sameAs: [GITHUB, DISCORD],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Lector",
    url: Astro.site?.href,
  },
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
// Guard against "</script>" breaking out of the JSON-LD block.
const ldJson = (s: object) => JSON.stringify(s).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Lector" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (Organization + WebSite sitewide, plus any page schema) -->
    {schemaGraph.map((s) => <script type="application/ld+json" set:html={ldJson(s)} />)}

    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.svg" />

    <!-- Set the theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
        else if (window.matchMedia("(prefers-color-scheme: dark)").matches)
          document.documentElement.setAttribute("data-theme", "dark");
        else document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>

    {
      lcpImage && (
        <link
          rel="preload"
          as="image"
          href={lcpImage}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }

    <!-- Plausible: queue events now, fetch the script after first input. -->
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
      plausible.init();
      (function () {
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.src = "https://plausible.io/js/pa-NBQHiTrDyS5mweKtdqu6v.js";
          s.async = true;
          document.head.appendChild(s);
        }
        ["pointerdown", "keydown", "scroll", "touchstart"].forEach(function (e) {
          window.addEventListener(e, load, { once: true, passive: true });
        });
      })();
    </script>

    <!-- Display font after first paint. Do not put @font-face in the main CSS. -->
    <script is:inline>
      window.addEventListener("load", function () {
        var l = document.createElement("link");
        l.rel = "stylesheet";
        l.href = "/fonts/instrument-serif.css";
        document.head.appendChild(l);
      });
    </script>
  </head>
  <body class="text-olive-950 dark:text-white">
    <Navbar />

    <main class="isolate overflow-clip">
      <slot />
    </main>

    <Footer />

    <!-- Click-to-zoom lightbox for screenshots (delegated; renders on demand). -->
    <ImageZoom />

    <!-- Floating dark-mode toggle (bottom-right). -->
    <button
      type="button"
      class="theme-toggle"
      onclick="toggleTheme()"
      aria-label="Toggle dark mode"
    >
      <span class="icon-sun">&#x2600;</span>
      <span class="icon-moon">&#x1F319;</span>
    </button>

    <script is:inline>
      function toggleTheme() {
        var current = document.documentElement.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      }
    </script>
  </body>
</html>
