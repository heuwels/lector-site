---
import "../styles/global.css";
import { SITE_PAGES } from "../data/nav";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A self-hosted language learning reader with LingQ-style reading, Clozemaster-style cloze practice, and AnkiConnect integration. Your books, your data.",
} = Astro.props;

// Current path drives the active-link highlight in the top nav. A subpage is
// active when the path matches or sits under it (e.g. /blog/<post>/ → Blog,
// /reference-data/<lang>/ → Reference Data).
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href);

// Global footer nav: Home, every primary subpage (from src/data/nav.ts), then
// the external links. Rendered from one list so it can't fall out of sync.
const footerLinks = [
  { href: "/", label: "Home" },
  ...SITE_PAGES,
  { href: "https://github.com/heuwels/lector", label: "GitHub", external: true },
  {
    href: "https://github.com/sponsors/heuwels",
    label: "Sponsor",
    external: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
        else if (window.matchMedia("(prefers-color-scheme: dark)").matches)
          document.documentElement.setAttribute("data-theme", "dark");
        else document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-NBQHiTrDyS5mweKtdqu6v.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <header class="site-nav" id="site-nav">
      <div class="site-nav__inner container container--wide">
        <a href="/" class="site-nav__brand" aria-label="Lector — home">
          <img src="/logo.svg" alt="" class="site-nav__logo" />
          <span>lector</span>
        </a>
        <button
          type="button"
          class="site-nav__toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="site-nav-menu"
          onclick="toggleNav(this)"
        >
          <span class="site-nav__bar"></span>
          <span class="site-nav__bar"></span>
          <span class="site-nav__bar"></span>
        </button>
        <nav class="site-nav__menu" id="site-nav-menu" aria-label="Primary">
          {
            SITE_PAGES.map((page) => (
              <a
                href={page.href}
                class="site-nav__link"
                aria-current={isActive(page.href) ? "page" : undefined}
              >
                {page.label}
              </a>
            ))
          }
          <a
            href="https://github.com/heuwels/lector"
            class="site-nav__link site-nav__link--icon"
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              viewBox="0 0 16 16"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer>
      <div class="container">
        <nav class="footer-nav">
          {
            footerLinks.map((link, i) => (
              <>
                {i > 0 && (
                  <span class="footer-sep" aria-hidden="true">
                    ·
                  </span>
                )}
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </>
            ))
          }
        </nav>
        <p class="footer-copy">
          <em>Lector</em> &middot; Latin for "reader" &middot; Built by
          <a href="https://lukeboyle.com">Luke Boyle</a>
        </p>
      </div>
    </footer>

    <button
      type="button"
      class="theme-toggle"
      onclick="toggleTheme()"
      aria-label="Toggle dark mode"
    >
      <span class="icon-sun">&#x2600;</span>
      <span class="icon-moon">&#x1F319;</span>
    </button>

    <script is:inline>
      function toggleTheme() {
        var current = document.documentElement.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      }

      function toggleNav(btn) {
        var open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        document
          .getElementById("site-nav")
          .classList.toggle("site-nav--open", !open);
      }

      // Collapse the mobile menu on Escape or once we're back at desktop width.
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        var btn = document.querySelector(".site-nav__toggle");
        if (btn && btn.getAttribute("aria-expanded") === "true") toggleNav(btn);
      });
      window.addEventListener("resize", function () {
        if (window.innerWidth <= 640) return;
        var nav = document.getElementById("site-nav");
        if (!nav) return;
        nav.classList.remove("site-nav--open");
        var btn = nav.querySelector(".site-nav__toggle");
        if (btn) btn.setAttribute("aria-expanded", "false");
      });
    </script>
  </body>
</html>
