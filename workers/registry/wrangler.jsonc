// Container registry pull-through proxy (see src/index.ts).
//
// This config deliberately lives here rather than at the repo root. A root
// Wrangler config is auto-discovered, and the Pages deploys in
// .github/workflows/deploy.yml pass `--project-name`, which errors when a
// discovered config exists. Deploys name this file explicitly:
//
//   wrangler deploy --config workers/registry/wrangler.jsonc --env staging
//
// The Worker is independent of the Pages site: separate deploy, separate
// hostname, and registry traffic that never touches lector.dev.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lector-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Nothing should pull from a workers.dev URL; the hostname is part of the
  // documented pull command and needs to stay stable.
  "workers_dev": false,
  "observability": { "enabled": true },

  // Attaching a hostname here creates it and requests a certificate. That
  // certificate can take several minutes on a hostname Cloudflare has not
  // served before: DNS resolves and the port accepts connections well before
  // TLS works, so the gap looks like an outage rather than a wait. It happens
  // once per hostname, never on redeploys. verify.sh waits it out.
  "routes": [
    {
      "pattern": "registry.lector.dev",
      "custom_domain": true
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "PULLS",
      "dataset": "lector_registry_pulls"
    }
  ],

  // Holds one random salt per UTC day, each written with a 48-hour TTL so it
  // deletes itself. See `dailySalt` in src/index.ts. The namespaces hold nothing
  // else, so they can be emptied at any time without losing anything but a
  // day's ability to tell two pullers apart.
  "kv_namespaces": [
    {
      "binding": "SALTS",
      "id": "575160d810334ad695328a949a0f03b2"
    }
  ],
  "vars": {
    "UPSTREAM_OWNER": "heuwels",
    // Comma-separated. Anything not listed gets NAME_UNKNOWN, which is what
    // stops this from being an open proxy to all of GHCR.
    "ALLOWED_REPOS": "lector"
  },

  // Named environments inherit nothing from the top level in Wrangler, so the
  // bindings and vars are repeated rather than shared. Staging writes to its
  // own dataset; mixing test pulls into the real counts would defeat the point.
  "env": {
    "staging": {
      "name": "lector-registry-staging",
      "workers_dev": false,
      "observability": { "enabled": true },
      "routes": [
        {
          "pattern": "registry.sandbox.lector.dev",
          "custom_domain": true
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PULLS",
          "dataset": "lector_registry_pulls_staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SALTS",
          "id": "43add901ee684e96b7b2d04a425c3e99"
        }
      ],
      "vars": {
        "UPSTREAM_OWNER": "heuwels",
        "ALLOWED_REPOS": "lector"
      }
    }
  }
}
